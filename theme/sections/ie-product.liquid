{%- comment -%}
  Страница товара по макету: большая картинка слева, сведения справа,
  под ними — лента всех фотографий товара.

  Почему своя секция, а не блоки Horizon: в макете другой порядок и другой
  набор элементов (нет количества и мгновенной покупки, вишлист стоит в
  строке с названием), а лента фотографий должна управлять большой
  картинкой. Собрать это из блоков product-information можно было бы только
  сплошными обходами в CSS.

  Что берём у темы как есть: форму добавления в корзину
  (product-form-component + add-to-cart-button) и кнопку вишлиста. Поэтому
  корзина-шторка, аналитика и вишлист работают ровно как на остальном сайте.
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign gallery = product.media

  assign selected_index = 0
  if variant.featured_media
    assign selected_index = variant.featured_media.position | minus: 1
  endif

  comment
    add_label — надпись «в корзину» саму по себе. Её же отдаём в data-атрибуте:
    при выборе доступного размера скрипт возвращает кнопке эту надпись, и она
    не остаётся «Sold out» от первого варианта.
  endcomment
  assign add_label = 'products.product.add_to_cart' | t
  if section.settings.button_label != blank
    assign add_label = section.settings.button_label
  endif

  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t
  if variant and variant.available
    assign can_add_to_cart = true
    assign add_to_cart_text = add_label
  elsif variant
    assign add_to_cart_text = 'products.product.sold_out' | t
  endif

  comment
    Слова-признаки размера нужны в двух местах: чтобы решить, показывать ли
    кружок цвета из тега, и чтобы выбрать форму значения. Разбираем один раз.
  endcomment
  assign size_words = section.settings.size_words | downcase | split: ','

  comment
    Цвет у нас не опция варианта, а тег товара: каталог приезжает из
    BrandsGateway, где цвет один на карточку («Pink», «Black»). Поэтому
    рисуем его отдельным неинтерактивным кружком — переключать нечего.
    Если у товара всё-таки есть своя опция цвета, кружок не дублируем.
  endcomment
  assign has_color_option = false
  comment
    У товара без вариаций Shopify всё равно отдаёт опцию «Title» со значением
    «Default Title» — это не цвет, поэтому такие товары пропускаем.
  endcomment
  unless product.has_only_default_variant
    for option in product.options_with_values
      assign option_key = option.name | downcase
      assign option_is_size = false
      for word in size_words
        assign needle = word | strip
        if needle != blank and option_key contains needle
          assign option_is_size = true
          break
        endif
      endfor
      unless option_is_size
        assign has_color_option = true
      endunless
    endfor
  endunless

  assign color_name = ''
  assign color_hex = ''
  unless has_color_option
    assign tag_key = product.tags | join: '~|~' | downcase | prepend: '~|~' | append: '~|~'
    assign swatch_rows = section.settings.color_swatches | newline_to_br | replace: '<br />', '~~' | replace: '<br>', '~~'
    assign swatch_lines = swatch_rows | split: '~~'
    for line in swatch_lines
      assign parts = line | strip | split: '='
      assign candidate = parts[0] | strip
      assign candidate_hex = parts[1] | strip
      if candidate != blank and candidate_hex != blank
        comment
          Обрамляем разделителями, чтобы «Black» не совпал с тегом «Blackberry».
        endcomment
        assign candidate_key = candidate | downcase | prepend: '~|~' | append: '~|~'
        if tag_key contains candidate_key
          assign color_name = candidate
          assign color_hex = candidate_hex
          break
        endif
      endif
    endfor
  endunless

  assign product_form_id = 'ie-pdp-form-' | append: section.id
  assign atc_id = 'ie-pdp-atc-' | append: section.id
  assign scope = '#shopify-section-' | append: section.id
-%}

{%- comment -%} Шрифт, кегль и цвет названия задаются в редакторе темы. {%- endcomment -%}
{%- render 'ie-heading-style',
  font: section.settings.title_font,
  size: section.settings.title_size,
  color: section.settings.title_color,
  scope: scope
-%}

<script src="{{ 'ie-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'ie-product.js' | asset_url }}" type="module" fetchpriority="low"></script>

<ie-product
  class="ie-pdp"
  style="
    --ie-pdp-column: {{ section.settings.media_column }}%;
    --ie-pdp-image: {{ section.settings.media_width }}px;
    --ie-pdp-media-ratio: {{ section.settings.media_ratio }};
    --ie-pdp-info: {{ section.settings.info_width }}px;
    --ie-pdp-info-offset: {{ section.settings.info_offset }}px;
    --ie-pdp-vendor: {{ section.settings.vendor_size }}px;
    --ie-pdp-thumb: {{ section.settings.thumb_width }}px;
    --ie-pdp-thumb-gap: {{ section.settings.thumb_gap }}px;
    --ie-pdp-scrim: {{ section.settings.thumb_scrim }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
  data-text-add="{{ add_label | escape }}"
  data-text-sold-out="{{ 'products.product.sold_out' | t | escape }}"
  data-text-unavailable="{{ 'products.product.unavailable' | t | escape }}"
>
  <div class="ie-pdp__grid">
    {%- comment -%} Большая картинка. Её меняет лента снизу. {%- endcomment -%}
    <div class="ie-pdp__media">
      {%- if gallery.size > 0 -%}
        {%- assign main_media = gallery[selected_index] -%}
        <img
          class="ie-pdp__main"
          data-ie-main-image
          src="{{ main_media.preview_image | image_url: width: 1400 }}"
          srcset="
            {{ main_media.preview_image | image_url: width: 600 }} 600w,
            {{ main_media.preview_image | image_url: width: 900 }} 900w,
            {{ main_media.preview_image | image_url: width: 1400 }} 1400w
          "
          sizes="(min-width: 990px) {{ section.settings.media_width }}px, 100vw"
          alt="{{ main_media.alt | default: product.title | escape }}"
          width="{{ main_media.preview_image.width }}"
          height="{{ main_media.preview_image.height }}"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ie-pdp__main' }}
      {%- endif -%}

      {%- comment -%}
        Стрелки листания у большой фотографии.

        Свайп по картинке есть, но он подсказывает о себе только пальцем:
        на десктопе мышью его не нащупать, и покупатель видел одну фотографию,
        не догадываясь, что их четыре. Стрелки стоят в полях слева и справа
        от снимка — колонка шире картинки, место там свободное.

        Листание общее с лентой миниатюр и полноэкранным просмотром: все три
        двигают один и тот же индекс, поэтому что бы покупатель ни трогал,
        выбранной остаётся одна фотография.

        Гасить их на краях не нужно — листание зациклено.
      {%- endcomment -%}
      {%- if gallery.size > 1 -%}
        <button
          type="button"
          class="ie-pdp__media-arrow ie-pdp__media-arrow--prev"
          data-ie-media-prev
          aria-label="{{ 'Назад' | escape }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="ie-pdp__media-arrow ie-pdp__media-arrow--next"
          data-ie-media-next
          aria-label="{{ 'Вперёд' | escape }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <div class="ie-pdp__info">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="ie-pdp__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      {%- comment -%}
        Название и вишлист — одна строка: в макете иконка прижата к правому
        краю на уровне названия.
      {%- endcomment -%}
      <div class="ie-pdp__headline">
        <h1 class="ie-pdp__title ie-pdp__title--{{ section.settings.title_case }}">{{ product.title }}</h1>
        <div class="ie-pdp__wishlist">
          {%- render 'wishlist-button', product: product, context: 'product' -%}
        </div>
      </div>

      {%- comment -%}
        Оценка товара. Берётся из стандартных метаполей Shopify
        (reviews.rating / reviews.rating_count) — их заполняет приложение
        отзывов, и пишут их все распространённые: Judge.me, Loox, Fera.
        Поэтому строка не привязана к конкретному приложению и сама
        появляется, как только отзывы у товара есть.

        Пока отзывов нет — не рисуем ничего: пустые звёзды на карточке
        люксовой вещи читаются как «никто не купил».

        Звёзды — два слоя текста: серый ряд снизу, цветной сверху, обрезанный
        по доле оценки. Так дробная оценка показывается без полудюжины SVG
        и без картинок.
      {%- endcomment -%}
      {%- liquid
        assign rating = product.metafields.reviews.rating.value
        assign rating_count = product.metafields.reviews.rating_count.value | default: 0
        assign rating_pct = 0
        if rating != blank and rating.scale_max > 0
          assign rating_pct = rating.rating | times: 100.0 | divided_by: rating.scale_max
        endif
      -%}
      {%- if rating_count > 0 and rating_pct > 0 -%}
        <a class="ie-pdp__rating" href="#ie-pdp-reviews">
          <span
            class="ie-pdp__stars"
            style="--ie-rating-pct: {{ rating_pct }}%;"
            aria-hidden="true"
          >
            <i></i>
          </span>
          <span class="ie-pdp__rating-text">
            {{- rating.rating | round: 1 }} ({{ rating_count }})
          </span>
        </a>
      {%- endif -%}

      <p class="ie-pdp__price">
        <span data-ie-price>{{ variant.price | money }}</span>
        <s
          class="ie-pdp__price-compare"
          data-ie-compare
          {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}
        >
          {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money }}{%- endif -%}
        </s>
        <span
          class="ie-pdp__discount"
          data-ie-discount
          {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}
        >
          {%- if variant.compare_at_price > variant.price -%}
            −{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}%
          {%- endif -%}
        </span>
      </p>

      {%- if color_name != blank -%}
        <div class="ie-pdp__option">
          <p class="ie-pdp__option-label">{{ section.settings.color_label }}: {{ color_name }}</p>
          <div class="ie-pdp__values">
            <span
              class="ie-pdp__value ie-pdp__value--circle ie-pdp__value--static"
              style="--ie-pdp-swatch: {{ color_hex }};"
            >
              <span class="ie-pdp__value-face"></span>
            </span>
          </div>
        </div>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        <div class="ie-pdp__options">
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_index = forloop.index
              assign option_key = option.name | downcase

              comment
                Размер выбирают по надписи, всё остальное (цвет, материал) —
                глазами, поэтому размеры рисуем прямоугольниками, а остальное
                кружками. Список слов вынесен в настройки: названия опций
                приходят от поставщиков на разных языках.
              endcomment
              assign is_size = false
              for word in size_words
                assign needle = word | strip
                if needle != blank and option_key contains needle
                  assign is_size = true
                  break
                endif
              endfor
            -%}

            <fieldset class="ie-pdp__option" data-ie-option-group>
              <legend class="ie-pdp__option-label">
                {{ option.name }}: <span data-ie-option-value>{{ option.selected_value }}</span>
              </legend>

              <div class="ie-pdp__values">
                {%- for value in option.values -%}
                  {%- liquid
                    comment
                      Чем заливать кружок: образцом из настроек товара, а если
                      его не задали — фотографией варианта. Иначе кружок будет
                      пустым и по нему ничего не выберешь.
                    endcomment
                    assign fill = ''
                    unless is_size
                      if value.swatch.color
                        assign fill = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                      elsif value.swatch.image
                        assign fill = value.swatch.image | image_url: width: 80 | prepend: 'url(' | append: ')'
                      elsif value.variant.image
                        assign fill = value.variant.image | image_url: width: 80 | prepend: 'url(' | append: ')'
                      endif
                    endunless
                  -%}

                  <label
                    class="ie-pdp__value ie-pdp__value--{% if is_size %}box{% else %}circle{% endif %}{% unless value.available %} ie-pdp__value--out{% endunless %}"
                    {% if fill != blank %}style="--ie-pdp-swatch: {{ fill }};"{% endif %}
                  >
                    <input
                      type="radio"
                      name="ie-option-{{ option_index }}-{{ section.id }}"
                      value="{{ value.name | escape }}"
                      data-ie-option
                      {% if value.selected %}checked{% endif %}
                    >
                    <span class="ie-pdp__value-face">
                      {%- if is_size -%}
                        {{ value.name }}
                      {%- else -%}
                        <span class="visually-hidden">{{ value.name }}</span>
                      {%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- comment -%}
        Форма темы целиком: без выбора количества и без мгновенной покупки —
        в макете их нет.
      {%- endcomment -%}
      <product-form-component
        class="ie-pdp__form"
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        on:submit="/handleSubmit"
        data-quantity-default="1"
        data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>

        {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ variant.id }}"
          >
          <div class="product-form-buttons ie-pdp__buttons" ref="productFormButtons">
            <span class="product-form-text__error hidden" ref="addToCartTextError">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
            </span>

            <span class="ie-pdp__atc" data-ie-add-to-cart>
              {%- render 'add-to-cart-button',
                id: atc_id,
                class: 'ie-pdp__atc-button',
                can_add_to_cart: can_add_to_cart,
                product: product,
                add_to_cart_text: add_to_cart_text
              -%}
            </span>
          </div>
        {%- endform -%}
      </product-form-component>

      {%- if section.settings.show_sku and variant.sku != blank -%}
        <p class="ie-pdp__sku">
          {{ section.settings.sku_label }}
          <span data-ie-sku>{{ variant.sku }}</span>
        </p>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="ie-pdp__description rte">{{ product.description }}</div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Лента всех фотографий товара. Правила те же, что у листалки блога:
      без автопрокрутки и зацикливания, на краю стрелка пропадает,
      карточки тянутся мышью (assets/ie-slider.js).
    {%- endcomment -%}
    {%- if gallery.size > 1 -%}
      <div class="ie-pdp__gallery">
        <ie-slider class="ie-pdp__slider">
          <ul class="ie-pdp__track" data-slider-track>
            {%- for media in gallery -%}
              <li class="ie-pdp__slide" data-slider-slide>
                <button
                  type="button"
                  class="ie-pdp__thumb"
                  data-ie-thumb
                  data-src="{{ media.preview_image | image_url: width: 1400 }}"
                  data-zoom-src="{{ media.preview_image | image_url: width: 2400 }}"
                  data-srcset="{{ media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1400 }} 1400w"
                  data-alt="{{ media.alt | default: product.title | escape }}"
                  aria-label="{{ product.title | escape }} — {{ forloop.index }}"
                  {% if forloop.index0 == selected_index %}aria-current="true"{% endif %}
                >
                  {{
                    media.preview_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 450, 600, 800',
                      sizes: '(min-width: 990px) 20vw, 45vw',
                      alt: '',
                      class: 'ie-pdp__thumb-img'
                  }}
                </button>
              </li>
            {%- endfor -%}
          </ul>

          <div class="ie-pdp__nav">
            <button
              type="button"
              class="ie-pdp__arrow"
              data-slider-prev
              aria-label="{{ 'Назад' | escape }}"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              class="ie-pdp__arrow"
              data-slider-next
              aria-label="{{ 'Вперёд' | escape }}"
            >
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </ie-slider>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Место под виджет отзывов.

    Своей разметки отзывов у нас нет намеренно: сбор, модерация, письма
    покупателю после доставки и хранение фотографий — это работа приложения,
    а не темы. Здесь только площадка, куда его блок кладётся из редактора
    (Товар → Добавить блок → Приложения).

    Блок общий, `@app`, поэтому площадка не привязана к конкретному
    приложению: поменяют Judge.me на другое — блок просто переставят.

    Контейнер рисуется, только когда блок добавили: пустой заголовок
    «Отзывы» под товаром без отзывов не нужен.
  {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ie-pdp__reviews" id="ie-pdp-reviews">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    Полноэкранный просмотр фотографии.

    Родной <dialog> с showModal: он сам даёт затемнение (::backdrop), замок
    прокрутки, ловушку фокуса и закрытие по Esc. Писать это руками — значит
    переписывать то, что браузер уже умеет, и обычно хуже.

    Разметка одна на все фотографии: картинку внутри подменяет ie-product.js
    по тому же индексу, что и большая картинка на странице. Поэтому стрелки
    листают и просмотр, и страницу под ним — закрыв просмотр, покупатель
    видит ту фотографию, на которой остановился.

    Рисуем только когда фотографий больше нуля: без них открывать нечего.
  {%- endcomment -%}
  {%- if gallery.size > 0 -%}
    <dialog class="ie-pdp__zoom" data-ie-zoom aria-label="{{ product.title | escape }}">
      <div class="ie-pdp__zoom-stage" data-ie-zoom-stage>
        <img class="ie-pdp__zoom-img" data-ie-zoom-image alt="">
      </div>

      {%- comment -%}
        Кнопка зума — подсказка, что фото можно увеличить: щелчок и щипок
        сами по себе не видны. Значок меняется с «+» на «−» по data-zoomed
        у диалога (см. стили).
      {%- endcomment -%}
      <button
        type="button"
        class="ie-pdp__zoom-toggle"
        data-ie-zoom-toggle
        aria-pressed="false"
        aria-label="Zoom in"
        data-label-in="Zoom in"
        data-label-out="Zoom out"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6" stroke="currentColor" stroke-width="1.2"/>
          <path d="M15 15l5 5M8 10.5h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path class="ie-pdp__zoom-plus" d="M10.5 8v5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </button>

      <button
        type="button"
        class="ie-pdp__zoom-close"
        data-ie-zoom-close
        aria-label="{{ 'accessibility.close' | t | default: 'Закрыть' | escape }}"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
      </button>

      {%- comment -%}
        Стрелки нужны только когда есть между чем листать.
      {%- endcomment -%}
      {%- if gallery.size > 1 -%}
        <button
          type="button"
          class="ie-pdp__zoom-arrow ie-pdp__zoom-arrow--prev"
          data-ie-zoom-prev
          aria-label="{{ 'Назад' | escape }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="ie-pdp__zoom-arrow ie-pdp__zoom-arrow--next"
          data-ie-zoom-next
          aria-label="{{ 'Вперёд' | escape }}"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <p class="ie-pdp__zoom-counter" data-ie-zoom-counter aria-hidden="true"></p>
      {%- endif -%}
    </dialog>
  {%- endif -%}

  {%- comment -%}
    Цены отдаём уже отформатированными: правила форматирования валюты живут
    в Liquid, и цена после смены размера выглядит так же, как при загрузке.
  {%- endcomment -%}
  <script type="application/json" data-ie-variants>
    [
      {%- for v in product.variants -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available }},
          "price": {{ v.price | money | strip_html | json }},
          "sku": {{ v.sku | json }},
          {%- if v.compare_at_price > v.price -%}
            "compare_at": {{ v.compare_at_price | money | strip_html | json }},
            "discount": {{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round | prepend: '−' | append: '%' | json }},
          {%- else -%}
            "compare_at": null,
            "discount": null,
          {%- endif -%}
          "media_index": {% if v.featured_media %}{{ v.featured_media.position | minus: 1 }}{% else %}null{% endif %}
        }
      {%- endfor -%}
    ]
  </script>
</ie-product>

{% stylesheet %}
  .ie-pdp {
    display: block;
    padding-inline: var(--ie-gutter);
    color: var(--ie-ink);
  }

  .ie-pdp__grid {
    display: grid;
    /*
     * minmax(0, 1fr), а не auto: колонка по умолчанию тянется до max-content,
     * и лента фотографий (она шире экрана) распирала бы страницу вбок вместо
     * того, чтобы прокручиваться внутри себя.
     */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  /*
   * Верхняя строка — картинка и сведения, вторая строка целиком под лентой
   * фотографий: она идёт во всю ширину под обеими колонками.
   */
  @media (min-width: 990px) {
    .ie-pdp__grid {
      grid-template-columns: minmax(0, var(--ie-pdp-column, 50%)) minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 0;
      row-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }

    .ie-pdp__media {
      grid-column: 1;
      grid-row: 1;
    }

    .ie-pdp__info {
      grid-column: 2;
      grid-row: 1;
      /* Колонка стоит от середины страницы, но чуть правее — на этот отступ. */
      margin-inline-start: var(--ie-pdp-info-offset, 48px);
    }

    .ie-pdp__gallery {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /*
   * На телефоне лента фотографий идёт сразу под большой картинкой.
   *
   * В разметке порядок другой — картинка, сведения, лента, — потому что на
   * десктопе лента лежит во всю ширину под обеими колонками, и в потоке ей
   * место последней. На узком экране колонка одна, и лента уезжала вниз, под
   * цену, размеры и кнопку: чтобы посмотреть второе фото, надо было
   * пролистать всю карточку.
   *
   * Переставляем order, а не разметку: так десктоп остаётся как есть, а
   * порядок чтения для скринридера меняется только там, где меняется и
   * порядок на экране.
   */
  @media (max-width: 989px) {
    .ie-pdp__media {
      order: 1;
    }

    .ie-pdp__gallery {
      order: 2;
    }

    .ie-pdp__info {
      order: 3;
    }
  }

  /*
   * Левая колонка — половина страницы, но фотография занимает не всю её
   * ширину: ставим по центру, чтобы вокруг оставались одинаковые поля.
   */
  .ie-pdp__media {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /*
   * Стрелки стоят у краёв колонки, а не у краёв снимка: колонка шире
   * фотографии, и в этих полях они никому не мешают. На узком экране полей
   * нет, и стрелки ложатся поверх картинки — поэтому фон полупрозрачный
   * белый, как у стрелок ленты.
   *
   * 2.75rem — 44px, минимальная цель нажатия: ниже неё промахиваются пальцем.
   */
  .ie-pdp__media-arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--ie-line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.86);
    color: var(--ie-ink);
    cursor: pointer;
    transform: translateY(-50%);
    transition: background 0.2s ease;
  }

  .ie-pdp__media-arrow:hover {
    background: var(--ie-cream);
  }

  .ie-pdp__media-arrow svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ie-pdp__media-arrow--prev {
    inset-inline-start: 0;
  }

  .ie-pdp__media-arrow--next {
    inset-inline-end: 0;
  }

  /*
   * Картинка кликабельная — открывает полноэкранный просмотр, поэтому и
   * курсор об этом говорит. touch-action: pan-y оставляет странице
   * вертикальную прокрутку, а горизонтальный жест забирает себе скрипт:
   * свайпом по большой картинке листаются фотографии.
   *
   * Фона у картинки нет намеренно. Раньше стояла серая подложка #f4f4f4, и
   * при переключении фотографии она проглядывала, пока грузилась следующая —
   * на телефоне это читалось как мигающий серый экран. Теперь скрипт ждёт
   * загрузки и только потом подменяет src, так что подложка не нужна, а
   * заодно её нечему и показывать.
   */
  .ie-pdp__main {
    display: block;
    width: 100%;
    max-width: var(--ie-pdp-image, 460px);
    height: auto;
    aspect-ratio: var(--ie-pdp-media-ratio, 2 / 3);
    object-fit: cover;
    cursor: zoom-in;
    touch-action: pan-y;
    -webkit-user-drag: none;
  }

  /* ------------------------------------------------------------------ */
  /* Правая колонка                                                      */
  /* ------------------------------------------------------------------ */

  /*
   * Колонка прижата к левому краю своей половины, то есть начинается ровно
   * на середине страницы. Поэтому у сетки и нет промежутка между колонками:
   * иначе он сдвинул бы начало колонки правее середины.
   */
  .ie-pdp__info {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: var(--ie-pdp-info, 400px);
  }

  /* Бренд — крупно и жирно, без капса: как записан в карточке товара. */
  .ie-pdp__vendor {
    margin: 0;
    font-family: var(--ie-sans);
    font-size: var(--ie-pdp-vendor, 1.375rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ie-ink);
  }

  .ie-pdp__headline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .ie-pdp__title {
    margin: 0;
    font-family: var(--ie-heading-font, var(--ie-sans));
    font-weight: var(--ie-heading-weight, 400);
    font-style: var(--ie-heading-style, normal);
    font-size: var(--ie-heading-size, 0.8125rem);
    color: var(--ie-heading-color, var(--ie-ink));
    line-height: 1.35;
    letter-spacing: 0.1em;
  }

  .ie-pdp__title--upper {
    text-transform: uppercase;
  }

  .ie-pdp__title--none {
    text-transform: none;
  }

  /*
   * Кнопка вишлиста у темы идёт с подписью — в макете на её месте только
   * иконка, поэтому подпись убираем визуально, но оставляем в разметке:
   * wishlist.js держит в ней состояние «в вишлисте / добавить».
   */
  .ie-pdp__wishlist .wishlist-button__text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .ie-pdp__wishlist .wishlist-button__control {
    padding: 0;
    border: 0;
    background: none;
  }

  .ie-pdp__price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--ie-sans);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .ie-pdp__price-compare {
    color: var(--ie-muted);
  }

  .ie-pdp__discount {
    color: var(--ie-bordo);
  }

  /* ------------------------------------------------------------------ */
  /* Оценка и отзывы                                                     */
  /* ------------------------------------------------------------------ */

  .ie-pdp__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    text-decoration: none;
    color: var(--ie-muted);
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .ie-pdp__rating:hover .ie-pdp__rating-text {
    color: var(--ie-ink);
  }

  /*
   * Звёзды двумя слоями: серый ряд задаёт ширину, цветной лежит поверх
   * и обрезан по доле оценки. Разрядку обоим слоям задаём одну, иначе
   * верхний ряд разъедется с нижним и обрезка встанет не по звезде.
   */
  .ie-pdp__stars {
    position: relative;
    display: inline-block;
    color: var(--ie-line);
    letter-spacing: 0.1em;
    line-height: 1;
    white-space: nowrap;
  }

  .ie-pdp__stars::before,
  .ie-pdp__stars i::before {
    content: "\2605\2605\2605\2605\2605";
  }

  .ie-pdp__stars i {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--ie-rating-pct, 0%);
    overflow: hidden;
    color: var(--ie-bordo);
    font-style: normal;
    letter-spacing: inherit;
  }

  /*
   * Площадка под виджет отзывов идёт во всю ширину под карточкой товара:
   * приложения рисуют там свою сетку с фотографиями, и половина колонки
   * ей мала. Отбивка сверху — чтобы виджет не слипался с лентой фотографий.
   */
  .ie-pdp__reviews {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* ------------------------------------------------------------------ */
  /* Опции                                                               */
  /* ------------------------------------------------------------------ */

  .ie-pdp__options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ie-pdp__option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ie-pdp__option-label {
    display: block;
    padding: 0;
    margin: 0;
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--ie-ink);
  }

  .ie-pdp__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .ie-pdp__value input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ie-pdp__value-face {
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }

  .ie-pdp__value input:focus-visible + .ie-pdp__value-face {
    outline: 2px solid var(--ie-ink);
    outline-offset: 2px;
  }

  /* Размер — прямоугольник с надписью. */
  .ie-pdp__value--box .ie-pdp__value-face {
    min-width: 2.75rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--ie-line);
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .ie-pdp__value--box input:checked + .ie-pdp__value-face {
    border-color: var(--ie-ink);
  }

  /* Значения без остатка не прячем: покупатель должен видеть, что размер есть. */
  .ie-pdp__value--box.ie-pdp__value--out .ie-pdp__value-face {
    color: var(--ie-muted);
    text-decoration: line-through;
  }

  /*
   * Остальные опции — кружок с цветом. Обводка внутрь нужна светлым
   * оттенкам: белый кружок на белом фоне иначе не виден.
   */
  .ie-pdp__value--circle .ie-pdp__value-face {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--ie-pdp-swatch, #ddd);
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
    transition: box-shadow 0.2s ease;
  }

  .ie-pdp__value--circle input:checked + .ie-pdp__value-face {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12), 0 0 0 1px #fff, 0 0 0 2px var(--ie-ink);
  }

  .ie-pdp__value--circle.ie-pdp__value--out .ie-pdp__value-face {
    opacity: 0.35;
  }

  /* Цвет из тега показываем, но не предлагаем выбрать: вариант всего один. */
  .ie-pdp__value--static .ie-pdp__value-face {
    cursor: default;
  }

  /* ------------------------------------------------------------------ */
  /* Кнопка и подписи                                                    */
  /* ------------------------------------------------------------------ */

  .ie-pdp__atc {
    display: block;
  }

  .ie-pdp__buttons {
    display: block;
  }

  .ie-pdp__atc .ie-pdp__atc-button {
    width: 100%;
    border: 1px solid var(--ie-ink);
    border-radius: 0;
    background: transparent;
    color: var(--ie-ink);
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-block: 0.9rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .ie-pdp__atc .ie-pdp__atc-button:hover:not(:disabled) {
    background: var(--ie-ink);
    color: #fff;
  }

  /* Иконку корзины из кнопки темы убираем — в макете только надпись. */
  .ie-pdp__atc .add-to-cart-icon {
    display: none;
  }

  .ie-pdp__sku,
  .ie-pdp__description {
    margin: 0;
    font-family: var(--ie-sans);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--ie-ink);
  }

  .ie-pdp__sku {
    color: var(--ie-muted);
    letter-spacing: 0.04em;
  }

  /* ------------------------------------------------------------------ */
  /* Лента фотографий                                                    */
  /* ------------------------------------------------------------------ */

  .ie-pdp__gallery {
    /* В макете лента уходит за правый край экрана. */
    margin-inline-end: calc(-1 * var(--ie-gutter));
  }

  .ie-pdp__slider {
    display: block;
  }

  .ie-pdp__track {
    display: flex;
    gap: var(--ie-pdp-thumb-gap, 12px);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .ie-pdp__track::-webkit-scrollbar {
    display: none;
  }

  ie-slider[data-scrollable] .ie-pdp__track {
    cursor: grab;
  }

  ie-slider[data-dragging] .ie-pdp__track {
    cursor: grabbing;
    user-select: none;
  }

  .ie-pdp__slide {
    flex: 0 0 auto;
    width: var(--ie-pdp-thumb, 260px);
    scroll-snap-align: start;
  }

  .ie-pdp__thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #f4f4f4;
    cursor: pointer;
    -webkit-user-drag: none;
  }

  .ie-pdp__thumb-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ie-pdp-media-ratio, 2 / 3);
    object-fit: cover;
    -webkit-user-drag: none;
  }

  /*
   * Выбранная фотография показывается как есть, на остальные ложится
   * серая вуаль — так видно, какая сейчас в большой картинке.
   */
  .ie-pdp__thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ie-pdp-scrim, rgba(120, 120, 120, 0.28));
    transition: opacity 0.2s ease;
  }

  .ie-pdp__thumb[aria-current='true']::after {
    opacity: 0;
  }

  .ie-pdp__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-inline-end: var(--ie-gutter);
  }

  .ie-pdp__arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--ie-line);
    border-radius: 50%;
    background: #fff;
    color: var(--ie-ink);
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .ie-pdp__arrow svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ie-pdp__arrow:hover:not(:disabled) {
    background: var(--ie-cream);
  }

  /* Лента не зациклена: на краю стрелка пропадает совсем. */
  .ie-pdp__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }

  ie-slider:not([data-scrollable]) .ie-pdp__nav {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ie-pdp__track {
      scroll-behavior: auto;
    }
  }

  /* ------------------------------------------------------------------ */
  /* Полноэкранный просмотр                                              */
  /* ------------------------------------------------------------------ */

  /*
   * Диалог растягиваем на весь экран сами: браузер по умолчанию ужимает его
   * по содержимому и центрирует, а нам нужна тёмная комната во всю ширину.
   * Поля и рамку снимаем по той же причине — они у <dialog> свои.
   *
   * Закрытый диалог не показываем вовсе: без display: none он остаётся
   * в потоке нулевой высоты, но его absolute-потомки (стрелки, крестик)
   * продолжают ловить клики поверх страницы.
   */
  .ie-pdp__zoom {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--ie-ink);
    overflow: hidden;
  }

  .ie-pdp__zoom:not([open]) {
    display: none;
  }

  .ie-pdp__zoom::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }

  /*
   * Картинка вписывается целиком: в полноэкранном просмотре смотрят вещь,
   * а не композицию, и обрезать её по краям здесь незачем — в отличие от
   * карточки, где всем фотографиям нужна одна пропорция.
   */
  .ie-pdp__zoom-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: clamp(0.5rem, 3vw, 2.5rem);
    /*
     * Все жесты на сцене наши: щипок увеличивает фото, палец двигает
     * увеличенное, свайп листает. Отдай браузеру хоть pan-y — щипок
     * увеличивал бы всю страницу под диалогом, а не фотографию.
     */
    touch-action: none;
  }

  /*
   * Зум — transform поверх вписанной картинки: раскладка не меняется,
   * меняется только отрисовка, и браузер двигает её без пересчёта
   * страницы. Переход плавный на щелчок и кнопку; во время щипка и
   * ведения пальцем (data-gesture) его нет — иначе фото отставало бы
   * от пальца.
   */
  .ie-pdp__zoom-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    -webkit-user-drag: none;
    user-select: none;
    transform-origin: center;
    transition: transform 0.25s ease;
    cursor: zoom-in;
  }

  .ie-pdp__zoom[data-zoomed] .ie-pdp__zoom-img {
    cursor: zoom-out;
  }

  .ie-pdp__zoom[data-gesture] .ie-pdp__zoom-img {
    transition: none;
  }

  .ie-pdp__zoom-close,
  .ie-pdp__zoom-toggle,
  .ie-pdp__zoom-arrow {
    position: absolute;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.86);
    color: var(--ie-ink);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .ie-pdp__zoom-close:hover,
  .ie-pdp__zoom-toggle:hover,
  .ie-pdp__zoom-arrow:hover:not(:disabled) {
    background: var(--ie-cream);
  }

  .ie-pdp__zoom-close {
    top: clamp(0.75rem, 2vw, 1.5rem);
    inset-inline-end: clamp(0.75rem, 2vw, 1.5rem);
    width: 2.75rem;
    height: 2.75rem;
  }

  /*
   * Стрелки — под палец: 44px это минимальная цель нажатия, ниже неё
   * промахиваются. По вертикали ставим по центру картинки.
   */
  .ie-pdp__zoom-arrow {
    top: 50%;
    width: 2.75rem;
    height: 2.75rem;
    transform: translateY(-50%);
  }

  .ie-pdp__zoom-arrow--prev {
    inset-inline-start: clamp(0.5rem, 2vw, 1.5rem);
  }

  .ie-pdp__zoom-arrow--next {
    inset-inline-end: clamp(0.5rem, 2vw, 1.5rem);
  }

  /* Просмотр зациклен, так что гасить стрелки на краях не нужно. */
  /* Лупа — слева от крестика, тем же размером. */
  .ie-pdp__zoom-toggle {
    top: clamp(0.75rem, 2vw, 1.5rem);
    inset-inline-end: calc(clamp(0.75rem, 2vw, 1.5rem) + 3.25rem);
    width: 2.75rem;
    height: 2.75rem;
  }

  .ie-pdp__zoom[data-zoomed] .ie-pdp__zoom-plus {
    display: none;
  }

  .ie-pdp__zoom-close svg,
  .ie-pdp__zoom-toggle svg,
  .ie-pdp__zoom-arrow svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ie-pdp__zoom-counter {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    text-align: center;
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ie-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Товар",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Картинка" },
    { "type": "range", "id": "media_column", "label": "Ширина левой половины", "min": 30, "max": 60, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "media_width", "label": "Ширина фотографии", "min": 240, "max": 720, "step": 10, "unit": "px", "default": 460, "info": "Фотография стоит по центру левой половины." },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Пропорция",
      "default": "2 / 3",
      "options": [
        { "value": "2 / 3", "label": "2:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    },
    { "type": "header", "content": "Сведения" },
    { "type": "text", "id": "color_label", "label": "Подпись цвета", "default": "Color" },
    { "type": "textarea", "id": "color_swatches", "label": "Цвета из тегов", "default": "Black = #111111\nWhite = #ffffff\nGrey = #9a9a9a\nGray = #9a9a9a\nBeige = #e8dcc8\nBrown = #6b4a2f\nBlue = #2f4b8f\nNavy = #1b2a4a\nGreen = #3f6b45\nYellow = #e8c53a\nOrange = #e07b2f\nRed = #a52128\nPink = #f0c2cf\nPurple = #6b3f8f\nGold = #c8a24a\nSilver = #c9ccce", "info": "По строке на цвет: название тега = цвет кружка. Показывается, когда цвет не задан отдельной опцией товара." },
    { "type": "text", "id": "size_words", "label": "Слова, по которым узнаём размер", "default": "size, размер, beden, taglia, taille, talla, größe", "info": "Через запятую. Опции с такими словами в названии показываются прямоугольниками, остальные — цветными кружками." },
    { "type": "range", "id": "info_width", "label": "Ширина колонки", "min": 200, "max": 620, "step": 10, "unit": "px", "default": 400 },
    { "type": "range", "id": "info_offset", "label": "Отступ от середины", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48, "info": "Насколько колонка сдвинута правее середины страницы." },
    { "type": "checkbox", "id": "show_vendor", "label": "Показывать бренд", "default": true },
    { "type": "range", "id": "vendor_size", "label": "Кегль бренда", "min": 12, "max": 48, "step": 1, "unit": "px", "default": 22 },
    { "type": "text", "id": "button_label", "label": "Надпись на кнопке", "info": "Пусто — берётся из переводов темы." },
    { "type": "checkbox", "id": "show_sku", "label": "Показывать артикул", "default": true },
    { "type": "text", "id": "sku_label", "label": "Подпись артикула", "default": "Ref." },
    { "type": "header", "content": "Название" },
    { "type": "font_picker", "id": "title_font", "label": "Шрифт", "default": "source_sans_pro_n4" },
    { "type": "range", "id": "title_size", "label": "Кегль", "min": 11, "max": 48, "step": 1, "unit": "px", "default": 13 },
    { "type": "color", "id": "title_color", "label": "Цвет", "default": "#111111" },
    {
      "type": "select",
      "id": "title_case",
      "label": "Регистр",
      "default": "none",
      "options": [
        { "value": "upper", "label": "ЗАГЛАВНЫМИ" },
        { "value": "none", "label": "Как в карточке товара" }
      ]
    },
    { "type": "header", "content": "Лента фотографий" },
    { "type": "range", "id": "thumb_width", "label": "Ширина фотографии", "min": 140, "max": 420, "step": 10, "unit": "px", "default": 260 },
    { "type": "range", "id": "thumb_gap", "label": "Промежуток", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "thumb_scrim", "label": "Вуаль на невыбранных", "default": "#78787847" },
    { "type": "header", "content": "Отступы" },
    { "type": "range", "id": "padding_top", "label": "Сверху", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Снизу", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "IE — Товар" }]
}
{% endschema %}
