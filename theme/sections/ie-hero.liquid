{%- comment -%}
  Герой главной: изображение во всю ширину, необязательная ссылка и подпись.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign height = section.settings.height
-%}

<section class="ie-hero ie-hero--{{ height }}" style="--ie-hero-ratio: {{ section.settings.ratio }};">
  {%- if section.settings.link != blank -%}
    <a class="ie-hero__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.alt | default: shop.name | escape }}">
  {%- endif -%}

  {%- if image != blank -%}
    {{
      image
      | image_url: width: 3000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1900, 2400, 3000',
        alt: section.settings.alt,
        class: 'ie-hero__img'
    }}
  {%- else -%}
    <div class="ie-hero__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ie-hero__img' }}
    </div>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <div class="ie-hero__caption">
      <span>{{ section.settings.heading }}</span>
    </div>
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</section>

{% stylesheet %}
  .ie-hero {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: #eaeaea;
  }

  .ie-hero__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ie-hero__img,
  .ie-hero__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ie-hero--ratio .ie-hero__img,
  .ie-hero--ratio .ie-hero__placeholder {
    aspect-ratio: var(--ie-hero-ratio, 16 / 9);
  }

  .ie-hero--viewport .ie-hero__img,
  .ie-hero--viewport .ie-hero__placeholder {
    height: calc(100svh - var(--header-group-height, 0px));
    min-height: 30rem;
  }

  .ie-hero__caption {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1.5rem, 4vw, 3.5rem);
    text-align: center;
    color: #fff;
    font-family: var(--ie-display);
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.35);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Герой",
  "tag": "section",
  "class": "ie-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Изображение" },
    { "type": "text", "id": "alt", "label": "Alt-текст" },
    { "type": "text", "id": "heading", "label": "Подпись поверх фото" },
    { "type": "url", "id": "link", "label": "Ссылка" },
    {
      "type": "select",
      "id": "height",
      "label": "Высота",
      "default": "ratio",
      "options": [
        { "value": "ratio", "label": "По пропорции" },
        { "value": "viewport", "label": "На весь экран" }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Пропорция",
      "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    }
  ],
  "presets": [{ "name": "IE — Герой" }]
}
{% endschema %}
