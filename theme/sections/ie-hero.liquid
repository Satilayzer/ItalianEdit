{%- comment -%}
  Герой главной во всю ширину: видео или изображение.

  Видео фоновое — запускается само, зациклено, без панели управления, поэтому
  по правилам браузеров стартует немым. Галка «Звуком управляет динамик в шапке»
  отдаёт его общему переключателю звука (assets/ie-sound.js): без неё ролик
  остаётся немым всегда, как и другие декоративные видео темы.
{%- endcomment -%}

{%- liquid
  assign video = section.settings.video
  assign image = section.settings.image
  assign label = section.settings.alt | default: shop.name

  assign sound_scope = 'ignore'
  if section.settings.sound
    assign sound_scope = 'managed'
  endif
-%}

{%- assign scope = '#shopify-section-' | append: section.id -%}

{%- comment -%}
  Шрифт, кегль и цвет подписи задаются в редакторе темы.
{%- endcomment -%}
{%- render 'ie-heading-style',
  font: section.settings.heading_font,
  size: section.settings.heading_size,
  color: section.settings.heading_color,
  scope: scope
-%}

<section
  class="ie-hero ie-hero--{{ section.settings.height }}"
  style="--ie-hero-ratio: {{ section.settings.ratio }};{% if video != blank %} --ie-media-ratio: {{ video.aspect_ratio | default: 1.7778 }};{% endif %}"
  {% if video != blank %}data-ie-sound="{{ sound_scope }}"{% endif %}
>
  {%- if section.settings.link != blank -%}
    <a class="ie-hero__link" href="{{ section.settings.link }}" aria-label="{{ label | escape }}">
  {%- endif -%}

  {%- if video != blank -%}
    {{
      video
      | video_tag:
        image_size: '2000x',
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        class: 'ie-hero__video'
    }}
  {%- elsif image != blank -%}
    {{
      image
      | image_url: width: 3000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1900, 2400, 3000',
        alt: section.settings.alt,
        class: 'ie-hero__img'
    }}
  {%- else -%}
    <div class="ie-hero__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ie-hero__img' }}
    </div>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <div class="ie-hero__caption">
      <span>{{ section.settings.heading }}</span>
    </div>
  {%- endif -%}

  {%- if section.settings.link != blank -%}
    </a>
  {%- endif -%}
</section>

{% stylesheet %}
  .ie-hero {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: #eaeaea;
  }

  .ie-hero__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ie-hero__img,
  .ie-hero__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ie-hero--ratio .ie-hero__img,
  .ie-hero--ratio .ie-hero__placeholder {
    aspect-ratio: var(--ie-hero-ratio, 16 / 9);
  }

  .ie-hero--viewport .ie-hero__img,
  .ie-hero--viewport .ie-hero__placeholder {
    height: calc(100svh - var(--header-group-height, 0px));
    min-height: 30rem;
  }

  /*
   * Видео не обрезаем: высоту берём из собственной пропорции ролика, поэтому
   * настройки «Высота» и «Пропорция» на него не влияют — они для изображения.
   * Пропорция приходит из video.aspect_ratio, так что кадр не прыгает, пока
   * грузятся метаданные.
   */
  .ie-hero__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ie-media-ratio, 1.7778);
    object-fit: contain;
  }

  .ie-hero__caption {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(1.5rem, 4vw, 3.5rem);
    text-align: center;
    color: var(--ie-heading-color, #fff);
    font-family: var(--ie-heading-font, var(--ie-display));
    font-weight: var(--ie-heading-weight, 400);
    font-style: var(--ie-heading-style, normal);
    font-size: var(--ie-heading-size, 3rem);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 24px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 749px) {
    .ie-hero__caption {
      font-size: calc(var(--ie-heading-size, 3rem) * 0.6);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Герой",
  "tag": "section",
  "class": "ie-hero-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Видео",
      "info": "Если видео выбрано, изображение не показывается. Ролик показывается целиком, по своей пропорции."
    },
    {
      "type": "checkbox",
      "id": "sound",
      "label": "Звуком видео управляет динамик в шапке",
      "default": false,
      "info": "Выключено — ролик всегда немой. Включено — звук появляется, когда покупатель включает звук на сайте."
    },
    { "type": "image_picker", "id": "image", "label": "Изображение", "info": "Запасной вариант, если видео не выбрано." },
    { "type": "text", "id": "alt", "label": "Описание для доступности" },
    { "type": "text", "id": "heading", "label": "Подпись поверх" },
    { "type": "url", "id": "link", "label": "Ссылка" },
    {
      "type": "select",
      "id": "height",
      "label": "Высота",
      "default": "ratio",
      "info": "Для изображения. Видео всегда идёт по своей пропорции.",
      "options": [
        { "value": "ratio", "label": "По пропорции" },
        { "value": "viewport", "label": "На весь экран" }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Пропорция",
      "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    },
    { "type": "header", "content": "Оформление подписи" },
    { "type": "font_picker", "id": "heading_font", "label": "Шрифт", "default": "source_serif_4_n4" },
    { "type": "range", "id": "heading_size", "label": "Кегль", "min": 16, "max": 120, "step": 2, "unit": "px", "default": 48 },
    { "type": "color", "id": "heading_color", "label": "Цвет", "default": "#ffffff" }
  ],
  "presets": [{ "name": "IE — Герой" }]
}
{% endschema %}
