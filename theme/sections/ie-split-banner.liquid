{%- comment -%}
  Сплит-баннер: две (или больше) панели во всю ширину с крупной подписью.
{%- endcomment -%}

{%- assign scope = '#shopify-section-' | append: section.id -%}

{%- comment -%}
  Шрифт, кегль и цвет заголовка задаются в редакторе темы.
{%- endcomment -%}
{%- render 'ie-heading-style',
  font: section.settings.heading_font,
  size: section.settings.heading_size,
  color: section.settings.heading_color,
  scope: scope
-%}

<section class="ie-split" style="--ie-split-ratio: {{ section.settings.ratio }};">
  {%- for block in section.blocks -%}
    <a
      class="ie-split__panel"
      href="{{ block.settings.link | default: '#' }}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '600, 900, 1200, 1600, 2000',
            alt: block.settings.label,
            class: 'ie-split__img'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'ie-split__img' }}
      {%- endif -%}

      {%- if block.settings.label != blank -%}
        <span class="ie-split__label">{{ block.settings.label }}</span>
      {%- endif -%}
    </a>
  {%- endfor -%}
</section>

{% stylesheet %}
  .ie-split {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 750px) {
    .ie-split {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
  }

  .ie-split__panel {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    background: #ddd;
  }

  .ie-split__img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ie-split-ratio, 3 / 2);
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .ie-split__panel:hover .ie-split__img {
    transform: scale(1.03);
  }

  .ie-split__label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ie-heading-color, #fff);
    font-family: var(--ie-heading-font, var(--ie-display));
    font-weight: var(--ie-heading-weight, 400);
    font-style: var(--ie-heading-style, normal);
    font-size: var(--ie-heading-size, 4.5rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 749px) {
    .ie-split__label {
      font-size: calc(var(--ie-heading-size, 4.5rem) * 0.5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Сплит-баннер",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "ratio",
      "label": "Пропорция панели",
      "default": "3 / 2",
      "options": [
        { "value": "3 / 2", "label": "3:2" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "16 / 9", "label": "16:9" }
      ]
    },
    { "type": "header", "content": "Оформление заголовка" },
    { "type": "font_picker", "id": "heading_font", "label": "Шрифт", "default": "source_serif_4_n4" },
    { "type": "range", "id": "heading_size", "label": "Кегль", "min": 24, "max": 140, "step": 2, "unit": "px", "default": 72 },
    { "type": "color", "id": "heading_color", "label": "Цвет", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Панель",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Изображение" },
        { "type": "text", "id": "label", "label": "Подпись", "default": "WOMEN" },
        { "type": "url", "id": "link", "label": "Ссылка" }
      ]
    }
  ],
  "presets": [
    {
      "name": "IE — Сплит-баннер",
      "blocks": [
        { "type": "panel", "settings": { "label": "MEN" } },
        { "type": "panel", "settings": { "label": "WOMEN" } }
      ]
    }
  ]
}
{% endschema %}
