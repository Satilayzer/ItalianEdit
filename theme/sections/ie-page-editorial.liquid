{%- comment -%}
  Редакционная страница: фотография слева во всю высоту, текст справа,
  маленькая подпись в правом верхнем углу и призыв под всем этим.
  Сделано под About Us и How It Works по макету.

  Текст берётся из самой страницы (Online Store → Pages), а не из настроек
  секции: там его привыкли править, и там он был до нас. Секция отвечает
  только за раскладку, фотографию, подпись и призыв.

  В тексте страницы заголовки — h2 (серифом капсом), абзацы — p. Ничего
  больше не нужно: ни классов, ни обёрток.

  Фотография прижата к левому краю окна, как в макете. Ширина колонки
  с потолком: на широком экране 45% окна дали бы кадр выше экрана,
  а исходники у нас небольшие (446 и 627 px по ширине) — растягивать
  их дальше значит мылить.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign eyebrow = section.settings.eyebrow | default: page.title
  assign cta = section.settings.cta | strip

  assign ratio = section.settings.image_ratio
  if ratio == 'natural' and image != blank
    assign ratio = image.aspect_ratio
  endif
-%}

<section
  class="ie-editorial ie-editorial--{{ section.settings.text_align }}{% if image == blank %} ie-editorial--no-image{% endif %}"
  style="--ie-editorial-accent: {{ section.settings.cta_color }};"
>
  {%- comment -%}
    Заголовок страницы для скринридеров и поисковиков: визуально его
    заменяет маленькая подпись в углу, но h1 у страницы быть должен.
    Стоит здесь, а не в колонке текста: там он был бы первым ребёнком,
    и правило «отступ перед следующим заголовком» сработало бы уже на
    первом разделе.
  {%- endcomment -%}
  <h1 class="visually-hidden">{{ page.title }}</h1>

  {%- if eyebrow != blank -%}
    <p class="ie-editorial__eyebrow">{{ eyebrow }}</p>
  {%- endif -%}

  <div class="ie-editorial__body">
    {%- if image != blank -%}
      <div class="ie-editorial__media" style="--ie-editorial-ratio: {{ ratio }};">
        {%- capture img_style -%}object-position: center {{ section.settings.image_position }};{%- endcapture -%}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200, 1600',
            sizes: '(min-width: 750px) min(44vw, 46rem), 100vw',
            class: 'ie-editorial__img',
            style: img_style
        }}
      </div>
    {%- elsif request.design_mode -%}
      <div class="ie-editorial__media" style="--ie-editorial-ratio: 7 / 8;">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ie-editorial__img' }}
      </div>
    {%- endif -%}

    <div class="ie-editorial__text">
      {{ page.content }}
    </div>
  </div>

  {%- if cta != blank -%}
    <p class="ie-editorial__cta">
      {%- if section.settings.cta_link != blank -%}
        <a
          href="{{ section.settings.cta_link }}"
          {% if section.settings.cta_link contains '://' %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{- cta | escape | newline_to_br -}}
        </a>
      {%- else -%}
        {{- cta | escape | newline_to_br -}}
      {%- endif -%}
    </p>
  {%- endif -%}
</section>

{% stylesheet %}
  .ie-editorial {
    --ie-editorial-gap: clamp(2rem, 6vw, 6rem);

    padding-block: 1rem clamp(3rem, 7vw, 6rem);
    color: var(--ie-ink, #111);
  }

  /* Подпись в углу — вместо большого заголовка страницы. */
  .ie-editorial__eyebrow {
    margin: 0 0 1.25rem;
    padding-inline: var(--ie-gutter, 24px);
    font-family: var(--ie-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    text-align: end;
  }

  .ie-editorial__body {
    display: grid;
    row-gap: 2rem;
  }

  .ie-editorial__media {
    position: relative;
    aspect-ratio: var(--ie-editorial-ratio, 7 / 8);
    overflow: hidden;
    background: var(--ie-cream, #f4f0e9);
  }

  .ie-editorial__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ie-editorial__text {
    padding-inline: var(--ie-gutter, 24px);
    font-family: var(--ie-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #333;
  }

  /*
   * Заголовки разделов. Вес (0,1,1) против h2 темы с (0,0,1): у темы все
   * h2 по 44px капсом, и без этого правила каждый раздел кричал бы.
   */
  .ie-editorial__text h2,
  .ie-editorial__text h3 {
    margin: 0 0 1.25rem;
    font-family: var(--ie-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ie-ink, #111);
  }

  /* Между разделами — воздух, как в макете: они читаются отдельными блоками. */
  .ie-editorial__text * + h2,
  .ie-editorial__text * + h3 {
    margin-block-start: clamp(2.5rem, 5vw, 3.75rem);
  }

  .ie-editorial__text p {
    margin: 0 0 1em;
  }

  .ie-editorial__text p:last-child {
    margin-block-end: 0;
  }

  .ie-editorial__text a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /*
   * Призыв под страницей. Капитель, а не капс: в макете заглавные буквы
   * фраз выше строчных, и это даёт именно font-variant: small-caps.
   * Цвет — сливовый заголовков главной, меняется в настройках секции.
   */
  .ie-editorial__cta {
    margin: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    padding-inline: var(--ie-gutter, 24px);
    font-family: var(--ie-display);
    font-size: clamp(1.25rem, 2.1vw, 1.875rem);
    font-variant: small-caps;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-align: center;
    color: var(--ie-editorial-accent, #633f47);
  }

  .ie-editorial__cta a {
    color: inherit;
    text-decoration: none;
  }

  .ie-editorial__cta a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 750px) {
    .ie-editorial__body {
      grid-template-columns: clamp(18rem, 44vw, 46rem) minmax(0, 1fr);
      column-gap: var(--ie-editorial-gap);
      align-items: start;
      padding-inline-end: var(--ie-gutter, 24px);
    }

    .ie-editorial--center .ie-editorial__body {
      align-items: center;
    }

    .ie-editorial__text {
      max-width: 36rem;
      padding-inline: 0;
    }

    .ie-editorial--start .ie-editorial__text {
      padding-block-start: 1rem;
    }

    /* Без фотографии текст не прижимается к левому краю окна. */
    .ie-editorial--no-image .ie-editorial__body {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      padding-inline: var(--ie-gutter, 24px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Страница с фото",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Подпись в правом верхнем углу",
      "info": "Пусто — берётся название страницы."
    },
    { "type": "header", "content": "Фотография" },
    { "type": "image_picker", "id": "image", "label": "Фотография" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Пропорции кадра",
      "options": [
        { "value": "7 / 8", "label": "7:8 — как в макете" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "2 / 3", "label": "2:3" },
        { "value": "1 / 1", "label": "Квадрат" },
        { "value": "natural", "label": "Как у исходника" }
      ],
      "default": "7 / 8"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Что оставить в кадре при обрезке",
      "options": [
        { "value": "top", "label": "Верх" },
        { "value": "center", "label": "Середину" },
        { "value": "bottom", "label": "Низ" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Текст" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Текст относительно фотографии",
      "options": [
        { "value": "start", "label": "От верхнего края" },
        { "value": "center", "label": "По центру по высоте" }
      ],
      "default": "start"
    },
    { "type": "header", "content": "Призыв под страницей" },
    {
      "type": "textarea",
      "id": "cta",
      "label": "Текст",
      "info": "Перенос строки сохраняется. Пусто — призыва нет."
    },
    { "type": "url", "id": "cta_link", "label": "Ссылка" },
    { "type": "color", "id": "cta_color", "label": "Цвет", "default": "#633f47" }
  ],
  "presets": [{ "name": "IE — Страница с фото" }]
}
{% endschema %}
