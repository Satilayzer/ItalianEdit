{%- comment -%}
  Страница «Contact» по макету: вступление, панель WhatsApp с QR-кодом
  и ниже строки-ссылки (почта, FAQ) с кнопкой справа.

  Номер для ссылки wa.me собирается из того же поля, что показано на
  экране: держать его вторым полем — верный способ однажды поправить
  одно и забыть другое. Всё лишнее из номера снимаем фильтрами, потому
  что wa.me принимает только цифры.

  Строки — блоки, чтобы список правился в редакторе: сегодня почта и FAQ,
  завтра живой чат. Кнопка чата в теме есть (`#chat-drawer`), но Shop chat
  в магазине не подключён — элемент `<shopify-chat>` не определён, и шторка
  открывается пустой. Поэтому строки чата здесь нет.
{%- endcomment -%}

{%- liquid
  assign wa_number = section.settings.whatsapp_number
  assign wa_digits = wa_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.'
  assign qr = section.settings.whatsapp_qr
  assign show_wa = section.settings.whatsapp_show
  if wa_digits == blank
    assign show_wa = false
  endif
-%}

<section
  class="ie-contact"
  style="--ie-contact-top: {{ section.settings.padding_top }}px; --ie-contact-bottom: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.show_title -%}
    <h1 class="ie-contact__title">{{ page.title | default: 'Contact' }}</h1>
  {%- endif -%}

  {%- if section.settings.intro != blank -%}
    <div class="ie-contact__intro">{{ section.settings.intro }}</div>
  {%- endif -%}

  {%- if show_wa -%}
    <div class="ie-contact__whatsapp">
      <div class="ie-contact__wa-body">
        <p class="ie-contact__wa-name">
          <span class="ie-contact__wa-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.25 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24M8.53 7.33c-.16 0-.43.06-.65.31-.22.25-.87.85-.87 2.07 0 1.22.9 2.4 1.02 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28-.24-.13-1.46-.72-1.69-.8-.22-.09-.39-.13-.55.12-.16.25-.62.79-.76.95-.14.17-.28.19-.52.07-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.24-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.14.17-.24.25-.4.08-.17.04-.31-.02-.44-.06-.12-.55-1.35-.76-1.84-.2-.48-.4-.42-.55-.43z"/>
            </svg>
          </span>
          <span>WhatsApp ({{ wa_number }})</span>
        </p>

        {%- if section.settings.whatsapp_hours != blank -%}
          <p class="ie-contact__wa-hours">{{ section.settings.whatsapp_hours }}</p>
        {%- endif -%}

        <a class="ie-contact__button" href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">
          <span>{{ section.settings.whatsapp_button }}</span>
          <span class="ie-contact__arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>

      {%- if qr != blank -%}
        <div class="ie-contact__qr">
          {{ qr | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '160px', alt: qr.alt | default: 'WhatsApp QR' }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="ie-contact__rows">
      {%- for block in section.blocks -%}
        <div class="ie-contact__row" {{ block.shopify_attributes }}>
          <span class="ie-contact__row-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'mail' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="18" height="18">
                  <rect x="3" y="5" width="18" height="14"/>
                  <path d="m3 6 9 7 9-7"/>
                </svg>
              {%- when 'question' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="18" height="18">
                  <rect x="3" y="3" width="18" height="18"/>
                  <path d="M9.6 9.2a2.5 2.5 0 1 1 3.3 2.4c-.6.2-.9.7-.9 1.3v.6"/>
                  <path d="M12 16.6h.01"/>
                </svg>
              {%- when 'phone' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="18" height="18">
                  <path d="M6.5 3.5h3l1.5 4-2 1.4a12 12 0 0 0 5.1 5.1l1.4-2 4 1.5v3c0 .8-.7 1.5-1.5 1.5A16 16 0 0 1 5 5c0-.8.7-1.5 1.5-1.5Z"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="18" height="18">
                  <path d="M20 4H4v11h4v4l4.5-4H20z"/>
                </svg>
            {%- endcase -%}
          </span>

          <div class="ie-contact__row-text">
            {%- if block.settings.label != blank -%}
              <p class="ie-contact__row-label">{{ block.settings.label }}</p>
            {%- endif -%}
            {%- if block.settings.sublabel != blank -%}
              <p class="ie-contact__row-sub">{{ block.settings.sublabel }}</p>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            <a class="ie-contact__button ie-contact__button--ghost" href="{{ block.settings.link }}">
              <span>{{ block.settings.button_label }}</span>
              <span class="ie-contact__arrow" aria-hidden="true">&#8594;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.footnote != blank -%}
    <div class="ie-contact__footnote">{{ section.settings.footnote }}</div>
  {%- endif -%}
</section>

{% stylesheet %}
  .ie-contact {
    max-width: 62rem;
    margin-inline: auto;
    padding-inline: var(--ie-gutter);
    padding-block: var(--ie-contact-top, 48px) var(--ie-contact-bottom, 72px);
    font-family: var(--ie-sans);
    color: var(--ie-ink);
  }

  .ie-contact__title {
    margin: 0 0 1.5rem;
    font-family: var(--ie-display);
    font-size: 2rem;
    font-weight: 400;
    text-transform: none;
    color: var(--ie-bordo);
  }

  .ie-contact__intro {
    margin-block-end: 2.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .ie-contact__intro p {
    margin: 0;
  }

  /* Панель WhatsApp: текст слева, QR справа, на телефоне QR уходит под текст. */
  .ie-contact__whatsapp {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.75rem var(--ie-gutter);
    background: var(--ie-cream);
  }

  @media (min-width: 750px) {
    .ie-contact__whatsapp {
      grid-template-columns: 1fr auto;
      padding: 2rem 2.25rem;
    }
  }

  .ie-contact__wa-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
  }

  /* Зелёный — единственный чужой цвет на странице: он опознаёт мессенджер. */
  .ie-contact__wa-icon {
    display: inline-flex;
    color: #25d366;
  }

  .ie-contact__wa-hours {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ie-ink);
  }

  .ie-contact__qr {
    justify-self: start;
    width: 160px;
  }

  @media (min-width: 750px) {
    .ie-contact__qr {
      justify-self: end;
    }
  }

  .ie-contact__qr img {
    display: block;
    width: 100%;
    height: auto;
  }

  /*
   * Кнопка. Стрелка прижата к правому краю, а не идёт за текстом: у соседних
   * кнопок разной длины подписи, и по колонке стрелок ряд читается ровным.
   */
  .ie-contact__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-width: 11rem;
    margin-block-start: 1.5rem;
    padding: 0.75rem 1.1rem;
    background: var(--ie-bordo);
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .ie-contact__button:hover {
    background: var(--ie-mauve);
    color: #fff;
  }

  .ie-contact__button--ghost {
    margin-block-start: 0;
    background: transparent;
    color: var(--ie-ink);
    border: 1px solid var(--ie-bordo);
  }

  .ie-contact__button--ghost:hover {
    background: var(--ie-bordo);
    color: #fff;
  }

  .ie-contact__arrow {
    line-height: 1;
  }

  .ie-contact__rows {
    margin-block-start: 2.5rem;
  }

  /*
   * Строка: иконка, текст, кнопка. На телефоне кнопка переезжает под текст
   * и растягивается — в колонку 11rem рядом с подписью она не помещается.
   */
  .ie-contact__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 0.9rem;
    align-items: center;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--ie-bordo);
  }

  @media (min-width: 750px) {
    .ie-contact__row {
      grid-template-columns: auto 1fr auto;
      gap: 0.9rem;
    }
  }

  .ie-contact__row-icon {
    display: inline-flex;
    color: var(--ie-ink);
  }

  .ie-contact__row-label {
    margin: 0;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ie-contact__row-sub {
    margin: 0.3rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--ie-muted);
  }

  .ie-contact__row .ie-contact__button {
    grid-column: 1 / -1;
    width: 100%;
  }

  @media (min-width: 750px) {
    .ie-contact__row .ie-contact__button {
      grid-column: auto;
      width: auto;
    }
  }

  .ie-contact__footnote {
    margin-block-start: 2.25rem;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--ie-muted);
  }

  .ie-contact__footnote p {
    margin: 0 0 0.35rem;
  }

  .ie-contact__footnote a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Контакты",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Показывать заголовок страницы", "default": true },
    { "type": "richtext", "id": "intro", "label": "Вступление", "default": "<p>Our customer service team is at your complete disposal for any question about Italian Edit.</p>" },
    { "type": "header", "content": "WhatsApp" },
    { "type": "checkbox", "id": "whatsapp_show", "label": "Показывать блок", "default": true },
    { "type": "text", "id": "whatsapp_number", "label": "Номер", "info": "Показывается на странице; из него же собирается ссылка wa.me — лишние знаки снимаются сами.", "default": "+1 727 463 1656" },
    { "type": "text", "id": "whatsapp_hours", "label": "Часы работы", "default": "From Monday to Friday: 9:00–18:00 (EST)" },
    { "type": "text", "id": "whatsapp_button", "label": "Подпись кнопки", "default": "Open WhatsApp" },
    { "type": "image_picker", "id": "whatsapp_qr", "label": "QR-код", "info": "Ведёт на тот же номер. При смене номера картинку надо перегенерировать." },
    { "type": "header", "content": "Низ страницы" },
    { "type": "richtext", "id": "footnote", "label": "Сноска" },
    { "type": "header", "content": "Отступы" },
    { "type": "range", "id": "padding_top", "label": "Сверху", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Снизу", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Строка",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Иконка",
          "options": [
            { "value": "chat", "label": "Чат" },
            { "value": "mail", "label": "Почта" },
            { "value": "question", "label": "Вопрос" },
            { "value": "phone", "label": "Телефон" }
          ],
          "default": "chat"
        },
        { "type": "text", "id": "label", "label": "Название" },
        { "type": "text", "id": "sublabel", "label": "Подпись" },
        { "type": "url", "id": "link", "label": "Ссылка", "info": "Можно mailto: и tel:." },
        { "type": "text", "id": "button_label", "label": "Подпись кнопки", "default": "Access" }
      ]
    }
  ],
  "presets": [{ "name": "IE — Контакты" }]
}
{% endschema %}
