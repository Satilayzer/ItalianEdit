{%- comment -%}
  Заголовок раздела отдельной секцией.

  Нужен, чтобы подписывать блоки, разметка которых нам не принадлежит —
  например, ленту Instagram от приложения. Ставится в шаблоне прямо над
  таким блоком, а шрифт, кегль и цвет настраиваются как у остальных
  наших секций.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
-%}

{%- if heading != blank or subheading != blank -%}
  {%- assign scope = '#shopify-section-' | append: section.id -%}

  {%- render 'ie-heading-style',
    font: section.settings.heading_font,
    size: section.settings.heading_size,
    color: section.settings.heading_color,
    scope: scope
  -%}

  <div
    class="ie-section-heading"
    style="--ie-sh-top: {{ section.settings.padding_top }}px; --ie-sh-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {%- if heading != blank -%}
      <h2 class="ie-heading">{{ heading }}</h2>
    {%- endif -%}

    {%- if subheading != blank -%}
      <p class="ie-subheading">{{ subheading }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .ie-section-heading {
    padding-block: var(--ie-sh-top, 48px) var(--ie-sh-bottom, 24px);
    padding-inline: var(--ie-gutter);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Заголовок раздела",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "Follow Our Instagram" },
    { "type": "text", "id": "subheading", "label": "Подзаголовок" },
    { "type": "header", "content": "Оформление заголовка" },
    { "type": "font_picker", "id": "heading_font", "label": "Шрифт", "default": "source_serif_4_n4" },
    { "type": "range", "id": "heading_size", "label": "Кегль", "min": 16, "max": 96, "step": 1, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Цвет", "default": "#633F47" },
    { "type": "header", "content": "Отступы" },
    { "type": "range", "id": "padding_top", "label": "Сверху", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Снизу", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "IE — Заголовок раздела" }]
}
{% endschema %}
