{%- comment -%}
  Страница истории бренда: разворот из макета Figma.

  Верх — большая картинка слева во весь край окна, справа колонка: бирка
  бренда, порядковый номер у правого поля, цитата, вводный текст и малый
  кадр с подписью. Ниже — блоки: ряды изображений, текстовые куски,
  бирка и врезка «купить».

  Заголовок статьи (H1) по умолчанию скрыт визуально, но остаётся
  в разметке: в макете его нет, а странице он нужен — по нему её читают
  поисковики и скринридеры. Галка «Показывать заголовок» выводит его
  над цитатой.

  Картинок в секции нет намеренно: их подставляют в редакторе темы.
  Пока слот пуст, на его месте стоит плейсхолдер Shopify — так видно
  раскладку до загрузки кадров.
{%- endcomment -%}

{%- liquid
  assign scope = '#shopify-section-' | append: section.id

  assign number = section.settings.number | strip
  assign heading = section.settings.heading | strip
-%}

{%- comment -%}
  Шрифт, кегль и цвет заголовков задаются в редакторе темы.
{%- endcomment -%}
{%- render 'ie-heading-style',
  font: section.settings.heading_font,
  size: section.settings.heading_size,
  color: section.settings.heading_color,
  scope: scope
-%}

<article
  class="ie-story"
  style="
    --ie-story-media: {{ section.settings.media_width }}%;
    --ie-story-hero-ratio: {{ section.settings.image_ratio }};
    --ie-story-label: {{ section.settings.label_width }}px;
    --ie-story-label-ratio: {{ section.settings.label_ratio }};
    --ie-story-aside: {{ section.settings.aside_width }}px;
    --ie-story-aside-ratio: {{ section.settings.aside_ratio }};
    --ie-story-width: {{ section.settings.content_width }}px;
    --ie-story-quote: {{ section.settings.quote_size }}px;
    --ie-story-text: {{ section.settings.text_size }}px;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ie-story__spread">
    <div class="ie-story__hero">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 45vw, 100vw',
            alt: section.settings.image_alt,
            class: 'ie-story__hero-img'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ie-story__hero-img' }}
      {%- endif -%}
    </div>

    <div class="ie-story__col">
      <div class="ie-story__top">
        <span class="ie-story__label">
          {%- if section.settings.label != blank -%}
            {{
              section.settings.label
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '200, 300, 450, 600, 800',
                sizes: '(min-width: 990px) 20vw, 50vw',
                alt: heading,
                class: 'ie-story__label-img'
            }}
          {%- endif -%}
        </span>

        {%- if number != blank -%}
          <span class="ie-story__num">{{ number }}</span>
        {%- endif -%}
      </div>

      <div class="ie-story__intro">
        {%- if heading != blank -%}
          <h1 class="ie-story__title{% unless section.settings.heading_visible %} ie-story__title--hidden{% endunless %}">
            {{- heading -}}
          </h1>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="ie-story__quote">{{ section.settings.quote }}</blockquote>
        {%- endif -%}

        {%- if section.settings.lede != blank -%}
          <div class="ie-story__rte">{{ section.settings.lede }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.aside_image != blank or section.settings.aside_caption != blank -%}
        <figure class="ie-story__aside">
          {%- if section.settings.aside_image != blank -%}
            {{
              section.settings.aside_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '200, 300, 450, 600, 800',
                sizes: '(min-width: 990px) 16vw, 45vw',
                alt: section.settings.aside_caption,
                class: 'ie-story__aside-img'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'ie-story__aside-img' }}
          {%- endif -%}

          {%- if section.settings.aside_caption != blank -%}
            <figcaption class="ie-story__aside-cap">{{ section.settings.aside_caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'gallery' -%}
        {%- liquid
          comment
            Колонок ровно столько, сколько заполненных кадров: с двумя
            картинками ряд не должен оставлять пустую треть, а с одной
            становится широкой полосой во всю колонку — под баннер.
            Пока не загружено ни одного, показываем три плейсхолдера.
          endcomment
          assign shots = 0
          for i in (1..3)
            assign key = 'image_' | append: i
            if block.settings[key] != blank
              assign shots = shots | plus: 1
            endif
          endfor

          assign empty_gallery = false
          if shots == 0
            assign empty_gallery = true
            assign shots = 3
          endif
        -%}

        <div
          class="ie-story__wrap ie-story__gallery"
          style="--ie-story-cols: {{ shots }}; --ie-story-gap: {{ block.settings.gap }}px; --ie-story-shot-ratio: {{ block.settings.ratio }};"
          {{ block.shopify_attributes }}
        >
          {%- for i in (1..3) -%}
            {%- liquid
              assign image_key = 'image_' | append: i
              assign title_key = 'title_' | append: i
              assign note_key = 'note_' | append: i

              assign shot = block.settings[image_key]
              assign shot_title = block.settings[title_key]
              assign shot_note = block.settings[note_key]
            -%}

            {%- unless empty_gallery or shot != blank -%}
              {%- continue -%}
            {%- endunless -%}

            <figure class="ie-story__shot">
              {%- if shot != blank -%}
                {{
                  shot
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900, 1200',
                    sizes: '(min-width: 990px) 28vw, 90vw',
                    alt: shot_title,
                    class: 'ie-story__shot-img'
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'ie-story__shot-img' }}
              {%- endif -%}

              {%- if shot_title != blank or shot_note != blank -%}
                <figcaption class="ie-story__shot-cap">
                  {%- if shot_title != blank -%}
                    <span class="ie-story__shot-title">{{ shot_title }}</span>
                  {%- endif -%}
                  {%- if shot_note != blank -%}
                    <span class="ie-story__shot-note">{{ shot_note | newline_to_br }}</span>
                  {%- endif -%}
                </figcaption>
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>

      {%- when 'text' -%}
        <div class="ie-story__wrap" {{ block.shopify_attributes }}>
          <div class="ie-story__block" style="--ie-story-measure: {{ block.settings.width }}%;">
            {%- if block.settings.heading != blank -%}
              <h2 class="ie-story__sub">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="ie-story__rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>

      {%- when 'label' -%}
        <div
          class="ie-story__wrap ie-story__labelrow ie-story__labelrow--{{ block.settings.align }}"
          style="--ie-story-label: {{ block.settings.width }}px; --ie-story-label-ratio: {{ block.settings.ratio }};"
          {{ block.shopify_attributes }}
        >
          <span class="ie-story__label">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300, 450, 600, 800',
                  sizes: '(min-width: 990px) 20vw, 50vw',
                  alt: heading,
                  class: 'ie-story__label-img'
              }}
            {%- endif -%}
          </span>
        </div>

      {%- when 'cta' -%}
        <div class="ie-story__wrap" {{ block.shopify_attributes }}>
          <div class="ie-story__block ie-story__cta" style="--ie-story-measure: {{ block.settings.width }}%;">
            {%- if block.settings.heading != blank -%}
              <h2 class="ie-story__sub">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="ie-story__rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="ie-story__btn" href="{{ block.settings.button_link | default: '/collections/all' }}">
                {{- block.settings.button_label -}}
              </a>
            {%- endif -%}
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}
</article>

{% stylesheet %}
  /*
   * Контентная колонка ниже разворота: в макете она заметно у́же окна
   * и не совпадает с общим полем витрины, поэтому ширина своя.
   */
  .ie-story__wrap {
    max-width: var(--ie-story-width, 1200px);
    margin-inline: auto;
    padding-inline: var(--ie-gutter);
  }

  /*
   * Разворот: левая картинка уходит в край окна — в макете она обрезана
   * границей страницы, а не полем вёрстки. Поле держит правая колонка.
   */
  .ie-story__spread {
    display: grid;
    grid-template-columns: minmax(0, var(--ie-story-media, 45%)) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .ie-story__hero-img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ie-story-hero-ratio, 4 / 5);
    object-fit: cover;
  }

  .ie-story__col {
    display: flex;
    flex-direction: column;
    padding-inline-end: var(--ie-gutter);
  }

  .ie-story__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  /*
   * Бирки приходят квадратами с пустым запасом вокруг рисунка, поэтому
   * окно прямоугольное и кадр обрезается по нему — так же, как на
   * странице дизайнеров. Пропорция правится настройкой.
   */
  .ie-story__label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--ie-story-label, 200px);
    max-width: 100%;
    aspect-ratio: var(--ie-story-label-ratio, 2 / 1);
    overflow: hidden;
  }

  .ie-story__label-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ie-story__num {
    flex: 0 0 auto;
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ie-ink);
  }

  /*
   * Текст обрывается заметно раньше номера — у правого поля колонки
   * остаётся воздух. Поэтому мера строки своя, а не ширина колонки.
   */
  .ie-story__intro {
    max-width: min(100%, 30rem);
    margin-block-start: clamp(2rem, 5vw, 4rem);
  }

  .ie-story__title {
    margin: 0 0 1rem;
    font-family: var(--ie-heading-font, var(--ie-display));
    font-weight: var(--ie-heading-weight, 400);
    font-style: var(--ie-heading-style, normal);
    font-size: var(--ie-heading-size, 1.75rem);
    line-height: 1.2;
    color: var(--ie-heading-color, var(--ie-ink));
    text-transform: none;
  }

  /*
   * Заголовок скрыт визуально, но остаётся в разметке: макет обходится
   * биркой, а поисковикам и скринридерам H1 нужен.
   */
  .ie-story__title--hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ie-story__quote {
    margin: 0 0 1.75rem;
    font-family: var(--ie-display);
    font-style: italic;
    font-size: var(--ie-story-quote, 17px);
    line-height: 1.45;
    color: var(--ie-ink);
  }

  .ie-story__quote p {
    margin: 0;
  }

  .ie-story__rte {
    font-family: var(--ie-sans);
    font-size: var(--ie-story-text, 13px);
    line-height: 1.65;
    color: var(--ie-ink);
  }

  .ie-story__rte p {
    margin: 0 0 1em;
  }

  .ie-story__rte p:last-child {
    margin-bottom: 0;
  }

  .ie-story__rte a {
    color: inherit;
  }

  .ie-story__aside {
    width: var(--ie-story-aside, 210px);
    max-width: 100%;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0 auto;
  }

  .ie-story__aside-img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ie-story-aside-ratio, 3 / 4);
    object-fit: cover;
  }

  .ie-story__aside-cap {
    margin-top: 0.625rem;
    font-family: var(--ie-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    color: var(--ie-ink);
  }

  .ie-story__gallery {
    display: grid;
    grid-template-columns: repeat(var(--ie-story-cols, 3), minmax(0, 1fr));
    gap: var(--ie-story-gap, 32px);
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
  }

  .ie-story__shot {
    position: relative;
    margin: 0;
  }

  /*
   * Пропорция «Как у файла» приходит значением auto: тогда высоту задаёт
   * сам кадр и обрезки нет. Обрезка при этом не выключается отдельно —
   * при aspect-ratio: auto коробка равна картинке, и cover нечего резать.
   */
  .ie-story__shot-img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ie-story-shot-ratio, 4 / 5);
    object-fit: cover;
  }

  /* Подпись лежит на кадре — в макете она белая поверх фотографии. */
  .ie-story__shot-cap {
    position: absolute;
    inset-inline: clamp(0.75rem, 2vw, 1.5rem);
    inset-block-end: clamp(0.75rem, 2vw, 1.5rem);
    display: grid;
    gap: 0.35em;
    color: #fff;
    font-family: var(--ie-sans);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .ie-story__shot-title {
    font-size: clamp(0.9375rem, 1.6vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ie-story__shot-note {
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .ie-story__block {
    max-width: var(--ie-story-measure, 62%);
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .ie-story__sub {
    margin: 0 0 0.75rem;
    font-family: var(--ie-heading-font, var(--ie-display));
    font-weight: var(--ie-heading-weight, 400);
    font-style: var(--ie-heading-style, normal);
    font-size: calc(var(--ie-heading-size, 1.75rem) * 0.62);
    line-height: 1.25;
    color: var(--ie-heading-color, var(--ie-ink));
    text-transform: none;
  }

  .ie-story__labelrow {
    display: flex;
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .ie-story__labelrow--center {
    justify-content: center;
  }

  .ie-story__labelrow--right {
    justify-content: flex-end;
  }

  .ie-story__btn {
    display: inline-block;
    margin-block-start: 1.5rem;
    padding: 0.75rem 2rem;
    border: 1px solid var(--ie-ink);
    font-family: var(--ie-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ie-ink);
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .ie-story__btn:hover {
    background: var(--ie-ink);
    color: var(--ie-cream);
  }

  /*
   * На узком экране разворот распадается на два этажа: картинка сверху
   * во всю ширину, текст под ней. Малый кадр перестаёт жаться вправо —
   * при одной колонке прижимать его не к чему.
   */
  @media (max-width: 989px) {
    .ie-story__spread {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 5vw, 2.5rem);
    }

    .ie-story__col {
      padding-inline: var(--ie-gutter);
    }

    .ie-story__intro {
      max-width: none;
      margin-block-start: clamp(1.25rem, 5vw, 2rem);
    }

    .ie-story__aside {
      margin-inline: 0;
    }

    .ie-story__gallery {
      grid-template-columns: minmax(0, 1fr);
    }

    .ie-story__block {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — История бренда",
  "tag": "section",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "Разворот" },
    {
      "type": "text",
      "id": "heading",
      "label": "Заголовок статьи (H1)",
      "info": "Остаётся в разметке для поиска, даже когда скрыт."
    },
    { "type": "checkbox", "id": "heading_visible", "label": "Показывать заголовок", "default": false },
    { "type": "text", "id": "number", "label": "Номер", "default": "001" },
    { "type": "image_picker", "id": "image", "label": "Большое изображение слева" },
    { "type": "text", "id": "image_alt", "label": "Описание изображения (alt)" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Пропорция большого изображения",
      "default": "4 / 5",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "2 / 3", "label": "2:3" }
      ]
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Ширина левой колонки",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 45
    },

    { "type": "header", "content": "Бирка бренда" },
    { "type": "image_picker", "id": "label", "label": "Бирка" },
    {
      "type": "range",
      "id": "label_width",
      "label": "Ширина бирки",
      "min": 100,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "select",
      "id": "label_ratio",
      "label": "Пропорция окна бирки",
      "default": "2 / 1",
      "options": [
        { "value": "7 / 2", "label": "3,5:1" },
        { "value": "3 / 1", "label": "3:1" },
        { "value": "5 / 2", "label": "5:2" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    },

    { "type": "header", "content": "Текст разворота" },
    { "type": "richtext", "id": "quote", "label": "Цитата" },
    { "type": "richtext", "id": "lede", "label": "Вводный текст" },

    { "type": "header", "content": "Малый кадр" },
    { "type": "image_picker", "id": "aside_image", "label": "Изображение" },
    { "type": "text", "id": "aside_caption", "label": "Подпись" },
    {
      "type": "range",
      "id": "aside_width",
      "label": "Ширина",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 210
    },
    {
      "type": "select",
      "id": "aside_ratio",
      "label": "Пропорция",
      "default": "3 / 4",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "2 / 3", "label": "2:3" }
      ]
    },

    { "type": "header", "content": "Оформление" },
    {
      "type": "range",
      "id": "content_width",
      "label": "Ширина контентной колонки",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    { "type": "range", "id": "quote_size", "label": "Кегль цитаты", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "text_size", "label": "Кегль текста", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 13 },
    { "type": "font_picker", "id": "heading_font", "label": "Шрифт заголовков", "default": "source_serif_4_n4" },
    { "type": "range", "id": "heading_size", "label": "Кегль заголовков", "min": 16, "max": 72, "step": 1, "unit": "px", "default": 28 },
