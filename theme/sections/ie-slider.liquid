{%- comment -%}
  Горизонтальная листалка картинок: заголовок и лента карточек со стрелками.

  Без автопрокрутки и без зацикливания — на краю лента останавливается,
  а стрелка пропадает. Прокрутка родная, поэтому свайп пальцем и трекпад
  работают сами; стрелки и перетаскивание мышью — в assets/ie-slider.js.

  Карточка становится ссылкой, только если ссылка задана: пока страницы
  блога не созданы, картинки просто не кликаются, а не ведут в никуда.
{%- endcomment -%}

{%- assign scope = '#shopify-section-' | append: section.id -%}

{%- comment -%}
  Шрифт, кегль и цвет заголовка задаются в редакторе темы.
{%- endcomment -%}
{%- render 'ie-heading-style',
  font: section.settings.heading_font,
  size: section.settings.heading_size,
  color: section.settings.heading_color,
  scope: scope
-%}

<script src="{{ 'ie-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>

<section
  class="ie-slider"
  style="
    --ie-slide-w: {{ section.settings.slide_width }}px;
    --ie-slide-ratio: {{ section.settings.ratio }};
    --ie-slider-gap: {{ section.settings.gap }}px;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="ie-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="ie-subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <ie-slider class="ie-slider__viewport">
    <button
      type="button"
      class="ie-slider__nav ie-slider__nav--prev"
      data-slider-prev
      aria-label="{{ 'Назад' | escape }}"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <ul class="ie-slider__track" data-slider-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link
          assign caption = block.settings.caption
        -%}
        <li class="ie-slider__slide" data-slider-slide {{ block.shopify_attributes }}>
          {%- if link != blank -%}
            <a class="ie-slider__card" href="{{ link }}">
          {%- else -%}
            <div class="ie-slider__card">
          {%- endif -%}

          <span class="ie-slider__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900, 1200',
                  sizes: '(min-width: 750px) 30vw, 80vw',
                  alt: caption,
                  class: 'ie-slider__img'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'ie-slider__img' }}
            {%- endif -%}
          </span>

          {%- if caption != blank -%}
            <span class="ie-slider__caption">{{ caption }}</span>
          {%- endif -%}

          {%- if link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <button
      type="button"
      class="ie-slider__nav ie-slider__nav--next"
      data-slider-next
      aria-label="{{ 'Вперёд' | escape }}"
    >
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </ie-slider>
</section>

{% stylesheet %}
  .ie-slider__viewport {
    position: relative;
    display: block;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .ie-slider__track {
    display: flex;
    gap: var(--ie-slider-gap, 16px);
    margin: 0;
    /*
     * Поля по краям равны промежутку между карточками: первая карточка
     * отступает от края витрины ровно настолько же, насколько карточки
     * отстоят друг от друга. Меняется вместе с настройкой «Промежуток».
     */
    padding-block: 0;
    padding-inline: var(--ie-slider-gap, 16px);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /*
     * Без этого прилипание «съедало» бы левое поле: карточка липнет к краю
     * видимой области, а не к краю поля, и в покое упиралась бы в край экрана.
     */
    scroll-padding-inline: var(--ie-slider-gap, 16px);
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .ie-slider__track::-webkit-scrollbar {
    display: none;
  }

  /*
   * На десктопе ленту тянут мышью (assets/ie-slider.js). Курсор показывает,
   * что карточки можно схватить; на тач-устройствах свайп родной, курсора нет.
   */
  ie-slider[data-scrollable] .ie-slider__track {
    cursor: grab;
  }

  ie-slider[data-dragging] .ie-slider__track {
    cursor: grabbing;
    user-select: none;
  }

  /* Иначе браузер начнёт тащить саму картинку вместо ленты. */
  .ie-slider__card,
  .ie-slider__img {
    -webkit-user-drag: none;
  }

  .ie-slider__slide {
    flex: 0 0 auto;
    width: var(--ie-slide-w, 300px);
    scroll-snap-align: start;
  }

  .ie-slider__card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .ie-slider__media {
    display: block;
    position: relative;
    aspect-ratio: var(--ie-slide-ratio, 3 / 4);
    overflow: hidden;
    background: #f2f2f2;
  }

  .ie-slider__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  a.ie-slider__card:hover .ie-slider__img {
    transform: scale(1.03);
  }

  .ie-slider__caption {
    font-family: var(--ie-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ie-ink);
    text-align: center;
  }

  /* ------------------------------------------------------------------ */
  /* Стрелки                                                             */
  /* ------------------------------------------------------------------ */

  .ie-slider__nav {
    position: absolute;
    top: calc(50% - 1.5rem);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--ie-line);
    border-radius: 50%;
    background: #fff;
    color: var(--ie-ink);
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .ie-slider__nav svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ie-slider__nav--prev {
    left: calc(var(--ie-gutter) / 2);
  }

  .ie-slider__nav--next {
    right: calc(var(--ie-gutter) / 2);
  }

  .ie-slider__nav:hover:not(:disabled) {
    background: var(--ie-cream);
  }

  /*
   * Лента не зациклена: на краю стрелка пропадает совсем — приглушённая
   * кнопка выглядела бы как рабочая. Из фокуса и от скринридера её убирает
   * сам disabled, поэтому visibility тут не нужен: он бы только сломал
   * плавное появление обратно. Если карточки влезают целиком, скрипт
   * снимает data-scrollable и стрелок нет вовсе.
   */
  .ie-slider__nav:disabled {
    opacity: 0;
    pointer-events: none;
  }

  ie-slider:not([data-scrollable]) .ie-slider__nav {
    display: none;
  }

  @media (max-width: 749px) {
    .ie-slider__nav {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ie-slider__track {
      scroll-behavior: auto;
    }

    .ie-slider__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Листалка картинок",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "Italian Edit Blog" },
    { "type": "text", "id": "subheading", "label": "Подзаголовок" },
    { "type": "header", "content": "Карточки" },
    { "type": "range", "id": "slide_width", "label": "Ширина карточки", "min": 160, "max": 520, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "gap", "label": "Промежуток", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Пропорция картинки",
      "default": "3 / 4",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "16 / 9", "label": "16:9" }
      ]
    },
    { "type": "header", "content": "Оформление заголовка" },
    { "type": "font_picker", "id": "heading_font", "label": "Шрифт", "default": "source_serif_4_n4" },
    { "type": "range", "id": "heading_size", "label": "Кегль", "min": 16, "max": 96, "step": 1, "unit": "px", "default": 44 },
    { "type": "color", "id": "heading_color", "label": "Цвет", "default": "#633F47" },
    { "type": "header", "content": "Отступы" },
    { "type": "range", "id": "padding_top", "label": "Сверху", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Снизу", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Карточка",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Картинка" },
        { "type": "text", "id": "caption", "label": "Подпись" },
        {
          "type": "url",
          "id": "link",
          "label": "Ссылка",
          "info": "Пусто — карточка не кликается. Проставьте, когда появятся страницы блога."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IE — Листалка картинок",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
