{%- comment -%}
  Страница 404: одно полноэкранное видео (или изображение). Заголовок и кнопка
  необязательны и по умолчанию пустые — шапка сайта на странице остаётся,
  так что уйти с 404 покупателю есть куда.

  Ролик фоновый, поэтому стартует немым: иначе браузер не даст автозапуск.
  Галка отдаёт его звук общему переключателю в шапке (assets/ie-sound.js).
{%- endcomment -%}

{%- liquid
  assign video = section.settings.video
  assign image = section.settings.image

  assign sound_scope = 'ignore'
  if section.settings.sound
    assign sound_scope = 'managed'
  endif
-%}

<section class="ie-404" {% if video != blank %}data-ie-sound="{{ sound_scope }}"{% endif %}>
  {%- if video != blank -%}
    {{
      video
      | video_tag:
        image_size: '2000x',
        autoplay: true,
        loop: true,
        muted: true,
        controls: false,
        class: 'ie-404__video'
    }}
  {%- elsif image != blank -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        loading: 'eager',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1900, 2400',
        alt: section.settings.heading,
        class: 'ie-404__img'
    }}
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'ie-404__img' }}
  {%- endif -%}

  {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
    <div class="ie-404__body">
      {%- if section.settings.heading != blank -%}
        <h1 class="ie-404__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="ie-pill" href="{{ section.settings.button_link | default: routes.root_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .ie-404 {
    position: relative;
    display: block;
    overflow: hidden;
    background: #e8e8e8;
  }

  .ie-404__img,
  .ie-404__video {
    display: block;
    width: 100%;
    height: calc(100svh - var(--header-group-height, 0px));
    min-height: 28rem;
    object-fit: cover;
  }

  /* Тема оборачивает видео своим контейнером — растягиваем и его. */
  .ie-404 .video-wrapper,
  .ie-404 deferred-media {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ie-404__body {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .ie-404__title {
    margin: 0;
    font-family: var(--ie-display);
    font-weight: 400;
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 2rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — 404",
  "tag": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Видео",
      "info": "Если видео выбрано, изображение не показывается."
    },
    {
      "type": "checkbox",
      "id": "sound",
      "label": "Звуком видео управляет динамик в шапке",
      "default": false,
      "info": "Выключено — ролик всегда немой. Включено — звук появляется, когда покупатель включает звук на сайте."
    },
    { "type": "image_picker", "id": "image", "label": "Изображение", "info": "Запасной вариант, если видео не выбрано." },
    { "type": "text", "id": "heading", "label": "Заголовок", "info": "Пусто — на странице только видео." },
    { "type": "text", "id": "button_label", "label": "Кнопка" },
    { "type": "url", "id": "button_link", "label": "Ссылка кнопки" }
  ],
  "presets": [{ "name": "IE — 404" }]
}
{% endschema %}
