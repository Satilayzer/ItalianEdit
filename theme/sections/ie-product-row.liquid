{%- comment -%}
  Полоса товаров из коллекции: заголовок, сетка и кнопка-таблетка.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.products_to_show
  assign columns = section.settings.columns
  assign columns_tablet = columns | at_most: 3

  assign products = section.settings.collection.products

  comment
    Коллекция «New» наполняется фоновой задачей по метке «новинка»: пока метки
    ни на одном товаре нет, коллекция пустая. Чтобы под баннером не висели
    плейсхолдеры, в этом случае показываем товары витрины целиком.
  endcomment
  if products.size == 0 and section.settings.fallback_to_all
    assign products = collections.all.products
  endif
-%}

{%- assign scope = '#shopify-section-' | append: section.id -%}

{%- comment -%}
  Шрифт, кегль и цвет заголовка задаются в редакторе темы.
{%- endcomment -%}
{%- render 'ie-heading-style',
  font: section.settings.heading_font,
  size: section.settings.heading_size,
  color: section.settings.heading_color,
  scope: scope
-%}

<section
  class="ie-product-row ie-section"
  style="--ie-columns: {{ columns }}; --ie-columns-tablet: {{ columns_tablet }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="ie-product-row__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="ie-grid">
    {%- if products.size > 0 -%}
      {%- for product in products limit: limit -%}
        {%- render 'ie-product-card',
          product: product,
          image_ratio: section.settings.ratio,
          show_vendor: section.settings.show_vendor
        -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <span class="ie-card" style="--ie-card-ratio: {{ section.settings.ratio }};">
          <span class="ie-card__media">{{ 'product-1' | placeholder_svg_tag: 'ie-card__image' }}</span>
          <span class="ie-card__body">
            <span class="ie-card__title">Product</span>
            <span class="ie-card__price">{{ 199900 | money_without_trailing_zeros }}</span>
          </span>
        </span>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="ie-product-row__cta">
      <a class="ie-pill" href="{{ section.settings.button_link | default: section.settings.collection.url }}">
        {{- section.settings.button_label -}}
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .ie-product-row {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .ie-product-row__heading {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    text-align: center;
    font-family: var(--ie-heading-font, var(--ie-sans));
    font-weight: var(--ie-heading-weight, 400);
    font-style: var(--ie-heading-style, normal);
    font-size: var(--ie-heading-size, 0.75rem);
    color: var(--ie-heading-color, var(--ie-ink));
    letter-spacing: 0.16em;
  }

  .ie-product-row__cta {
    margin-top: clamp(2rem, 4vw, 3.25rem);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Полоса товаров",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "New" },
    { "type": "collection", "id": "collection", "label": "Коллекция" },
    {
      "type": "checkbox",
      "id": "fallback_to_all",
      "label": "Показывать любые товары, если коллекция пуста",
      "default": true
    },
    { "type": "range", "id": "products_to_show", "label": "Сколько товаров", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Колонок на десктопе", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Пропорция картинки",
      "default": "2 / 3",
      "options": [
        { "value": "2 / 3", "label": "2:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Показывать бренд", "default": true },
    { "type": "text", "id": "button_label", "label": "Кнопка", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Ссылка кнопки" },
    { "type": "header", "content": "Оформление заголовка" },
    { "type": "font_picker", "id": "heading_font", "label": "Шрифт", "default": "source_sans_pro_n4" },
    { "type": "range", "id": "heading_size", "label": "Кегль", "min": 9, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "color", "id": "heading_color", "label": "Цвет", "default": "#111111" }
  ],
  "presets": [{ "name": "IE — Полоса товаров" }]
}
{% endschema %}
