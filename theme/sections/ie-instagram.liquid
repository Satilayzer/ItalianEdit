{%- comment -%}
  Мозаика Instagram: заголовок и ряд кадров разной ширины.
{%- endcomment -%}

{%- liquid
  assign fallback_url = section.settings.profile_url
-%}

<section class="ie-insta">
  {%- if section.settings.heading != blank -%}
    <h2 class="ie-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="ie-subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="ie-insta__track" style="--ie-insta-height: {{ section.settings.height }}px;">
    {%- for block in section.blocks -%}
      {%- assign href = block.settings.link | default: fallback_url -%}
      <a
        class="ie-insta__item ie-insta__item--{{ block.settings.width }}"
        href="{{ href | default: '#' }}"
        {% if href != blank %}target="_blank" rel="noopener"{% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 900, 1400',
              sizes: '(min-width: 750px) 30vw, 80vw',
              alt: block.settings.caption,
              class: 'ie-insta__img'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ie-insta__img' }}
        {%- endif -%}

        {%- if block.settings.caption != blank -%}
          <span class="ie-insta__caption">{{ block.settings.caption }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .ie-insta {
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .ie-insta__track {
    display: flex;
    align-items: stretch;
    gap: clamp(0.75rem, 2vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3.25rem);
    padding-inline: var(--ie-gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .ie-insta__track::-webkit-scrollbar {
    display: none;
  }

  .ie-insta__item {
    position: relative;
    flex: 0 0 auto;
    height: var(--ie-insta-height, 480px);
    overflow: hidden;
    text-decoration: none;
    background: #f2f2f2;
  }

  .ie-insta__item--narrow {
    width: clamp(11rem, 18vw, 17rem);
  }

  .ie-insta__item--wide {
    width: clamp(16rem, 32vw, 32rem);
  }

  .ie-insta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }

  .ie-insta__item:hover .ie-insta__img {
    transform: scale(1.04);
  }

  .ie-insta__caption {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.9);
    color: var(--ie-ink);
    font-family: var(--ie-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Instagram",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "Follow Our Instagram" },
    { "type": "text", "id": "subheading", "label": "Подзаголовок" },
    { "type": "url", "id": "profile_url", "label": "Ссылка на профиль" },
    { "type": "range", "id": "height", "label": "Высота кадров, px", "min": 260, "max": 640, "step": 20, "default": 480 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Кадр",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Изображение" },
        { "type": "text", "id": "caption", "label": "Подпись поверх" },
        { "type": "url", "id": "link", "label": "Ссылка" },
        {
          "type": "select",
          "id": "width",
          "label": "Ширина",
          "default": "narrow",
          "options": [
            { "value": "narrow", "label": "Узкий" },
            { "value": "wide", "label": "Широкий" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IE — Instagram",
      "blocks": [
        { "type": "post", "settings": { "width": "narrow" } },
        { "type": "post", "settings": { "width": "wide" } },
        { "type": "post", "settings": { "width": "narrow" } }
      ]
    }
  ]
}
{% endschema %}
