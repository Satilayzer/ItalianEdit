{% doc %}
  Cart Products

  Renders the cart products list or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state
  @param {block} [block] - The block object providing settings and editor attributes.
  @param {string} [context] - Render context — pass `'drawer'` when rendered inside the cart drawer to enable drawer-specific styles.

  @example
  {% render 'cart-products', force_empty: true %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.input_style == 'custom' -%}
  {%- capture custom_style -%}
    {%- render 'input-custom-styles', block_settings: block_settings -%}
    --style-border-width-inputs: {{ block_settings.border_width }}px;
    --style-border-radius-inputs: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-primary: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-secondary: {{ block_settings.border_radius }}px;
  {%- endcapture -%}
{%- endif -%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'ie-cart-variant.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'text-component-shimmer-styles' %}

<div
  {{ block.shopify_attributes }}
  class="cart-items__wrapper{% if context == 'drawer' and cart.empty? or force_empty %} cart-items__wrapper--drawer-empty{% endif %}"
  {% if context == 'drawer' and cart.empty? or force_empty %}
    data-cart-drawer-empty
  {% endif %}
  style="
    {%- if settings.product_title_case == 'uppercase' -%}--product-title-case: uppercase;{%- endif -%}
    {{- custom_style -}}
  "
>
  {% if cart.empty? or force_empty %}
    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p>
        {{ 'actions.log_in_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}

    <a
      class="button cart-items__empty-button"
      href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
    >
      <span class="button-text">
        {{ 'actions.continue_shopping' | t }}
      </span>
    </a>
  {%- else -%}
    <span
      class="visually-hidden"
      ref="cartItemCount"
      aria-hidden="true"
    >
      {{- cart.item_count -}}
    </span>
    <form
      action="{{ routes.cart_url }}"
      class="cart-form"
      id="cart-form"
      method="post"
    >
      <div
        class="cart-items spacing-style{% if block_settings.dividers %} cart-items--dividers{% endif %}"
        style="{%  render 'spacing-style', settings: block_settings %} --cart-items-gap:{{ block_settings.gap | append: "px" }};"
      >
        <table
          class="cart-items__table"
          role="table"
        >
          <caption
            class="visually-hidden"
            role="caption"
          >
            {{ 'content.cart_total' | t }}
            <span>{{ cart.total_price | money_with_currency }}</span>
          </caption>

          <thead
            class="visually-hidden"
            role="rowgroup"
          >
            <tr
              role="row"
              class="cart-items__table-row"
            >
              <th
                id="productImage"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_image' | t }}
              </th>
              <th
                id="productInformation"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_information' | t }}
              </th>
            </tr>
          </thead>

          <tbody role="rowgroup">
            {% for item in cart.items %}
              <tr
                id="CartItem-{{ item.key }}"
                role="row"
                class="cart-items__table-row{% if item.parent_relationship.parent != null %} cart-items__nested-line{% endif %}"
                ref="cartItemRows[]"
                data-parent-key="{{ item.parent_relationship.parent.key }}"
                data-key="{{ item.key }}"
              >
                <td
                  class="cart-items__media"
                  role="cell"
                  headers="productImage"
                >
                  {% if item.image -%}
                    {% liquid
                      assign ratio = 1
                      assign border_opacity = settings.cart_thumbnail_border_opacity | divided_by: 100.0
                      assign border_override = '--border-width: [cart_thumbnail_border_width]px; --border-style: [cart_thumbnail_border_style]; --border-color: rgb(var(--color-border-rgb) / [cart_thumbnail_border_opacity]); --border-radius: [cart_thumbnail_border_radius]px;' | replace: '[cart_thumbnail_border_width]', settings.cart_thumbnail_border_width | replace: '[cart_thumbnail_border_style]', settings.cart_thumbnail_border | replace: '[cart_thumbnail_border_opacity]', border_opacity | replace: '[cart_thumbnail_border_radius]', settings.cart_thumbnail_border_radius

                      if settings.cart_thumbnail_border_radius > 0
                        assign border_override = border_override | append: ' overflow: hidden;'
                      endif
                      if block_settings.image_ratio == 'portrait'
                        assign ratio = 0.8
                      elsif block_settings.image_ratio == 'adapt'
                        assign ratio = item.image.aspect_ratio
                      endif
                    %}
                    <a
                      href="{{ item.url }}"
                      class="cart-items__media-container"
                      style="--ratio:{{ ratio }};"
                    >
                      {%- liquid
                        echo item.image | image_url: width: 250 | image_tag: class: 'cart-items__media-image border-style', style: border_override
                      -%}
                    </a>
                  {%- endif %}
                </td>
                <td
                  class="cart-items__details cart-primary-typography"
                  role="cell"
                  headers="productInformation"
                >
                  <div class="cart-items__product-info">
                    {%- liquid
                      assign cart_disclosure_unique_id = 'page-' | append: item.index
                      if context == 'drawer'
                        assign cart_disclosure_unique_id = 'drawer-' | append: item.index
                      endif
                    -%}

                    {%- comment -%}
                      Бренд отдельной строкой НАД названием — так же, как в карточках
                      (blocks/product-title.liquid) и на странице товара. Прячем его,
                      если vendor совпал с именем магазина или уже стоит в начале
                      названия: иначе выйдет «GUCCI / GUCCI OPHIDIA BAG».

                      Настройка блока `vendor` тут больше ни при чём: бренд — часть
                      макета корзины, а не необязательная добавка, и выключенная
                      галка просто ломала бы вёрстку строки.
                    {%- endcomment -%}
                    {%- liquid
                      assign line_vendor = item.product.vendor
                      if line_vendor != blank
                        assign vendor_downcase = line_vendor | downcase
                        assign shop_downcase = shop.name | downcase
                        assign title_start = item.product.title | downcase | truncate: vendor_downcase.size, ''
                        if vendor_downcase == shop_downcase or title_start == vendor_downcase
                          assign line_vendor = blank
                        endif
                      endif
                    -%}
                    {%- if line_vendor != blank -%}
                      <p class="cart-items__vendor product-designer">{{ line_vendor }}</p>
                    {%- endif -%}

                    <div class="cart-items__title-row">
                      <a
                        href="{{ item.url }}"
                        class="cart-items__title"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{ 'accessibility.nested_product' | t: product_title: item.product.title, parent_title: item.parent_relationship.parent.title | escape }}"
                        {% endif %}
                      >
                        {{- item.product.title -}}
                      </a>
                      {% render 'cart-disclosure-tooltip',
                        product: item.product,
                        unique_id: cart_disclosure_unique_id,
                        mode: 'trigger'
                      %}
                    </div>

                    {%- if item.item_components.size != 0 -%}
                      <ul class="cart-items__bundle list-unstyled">
                        {%- for component in item.item_components -%}
                          <li>
                            {{- component.title -}}
                            {%- if component.quantity > 1 -%}
                              <span> × {{ component.quantity }}</span>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                  {%- comment -%}
                    Всё про цену — одной строкой: наша цена чёрным, прежняя
                    серым и зачёркнутая, следом размер скидки. Отдельной
                    колонки с итогом по строке больше нет — при количестве 1
                    она повторяла ту же цифру, а в макете её нет.

                    Процент считаем ДО money-фильтров, пока цены — числа
                    в центах, и по тем же двум числам, которые выводятся
                    рядом, иначе он разойдётся с зачёркнутой ценой.
                  {%- endcomment -%}
                  {%- liquid
                    assign line_price = item.original_price
                    assign line_compare = item.variant.compare_at_price
                    if item.original_price != item.final_price
                      assign line_price = item.final_price
                      if item.variant.compare_at_price <= item.original_price
                        assign line_compare = item.original_price
                      endif
                    endif

                    assign line_discount = 0
                    if line_compare > line_price
                      assign line_discount = line_compare | minus: line_price | times: 100.0 | divided_by: line_compare | round
                    endif
                  -%}
                  <p class="cart-items__price-row">
                    <span class="visually-hidden">
                      {%- if line_compare > line_price -%}
                        {{ 'content.price_sale' | t }}
                      {%- else -%}
                        {{ 'content.price' | t }}
                      {%- endif -%}
                    </span>
                    <span class="cart-items__price-current">{{ line_price | money }}</span>
                    {%- if line_compare > line_price -%}
                      <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                      <s class="cart-items__price-compare">{{ line_compare | money }}</s>
                      <span class="cart-items__discount">&#8722;{{ line_discount }}%</span>
                    {%- endif -%}
                  </p>

                  {%- comment -%}
                    Цвет и размер под ценой — как на странице товара.

                    Цвет у нас не опция варианта, а тег товара: каталог едет
                    из BrandsGateway, где цвет один на карточку. Поэтому он
                    рисуется неинтерактивным кружком — переключать нечего.
                    Таблица «тег = цвет» продублирована с настроек секции
                    ie-product: секция и сниппет друг друга не видят, а в
                    макете цвет есть и в корзине. Меняете список там —
                    поправьте и здесь.
                  {%- endcomment -%}
                  {%- liquid
                    assign size_words = 'size, размер, beden, taglia, taille, talla, größe' | downcase | split: ','
                    assign color_table = 'Black = #111111|White = #ffffff|Grey = #9a9a9a|Gray = #9a9a9a|Beige = #e8dcc8|Brown = #6b4a2f|Blue = #2f4b8f|Navy = #1b2a4a|Green = #3f6b45|Yellow = #e8c53a|Orange = #e07b2f|Red = #a52128|Pink = #f0c2cf|Purple = #6b3f8f|Gold = #c8a24a|Silver = #c9ccce' | split: '|'

                    assign line_product = item.product
                    assign cur1 = item.variant.option1
                    assign cur2 = item.variant.option2
                    assign cur3 = item.variant.option3

                    assign has_color_option = false
                    unless line_product.has_only_default_variant
                      for option in line_product.options_with_values
                        assign option_key = option.name | downcase
                        assign option_is_size = false
                        for word in size_words
                          assign needle = word | strip
                          if needle != blank and option_key contains needle
                            assign option_is_size = true
                            break
                          endif
                        endfor
                        unless option_is_size
                          assign has_color_option = true
                        endunless
                      endfor
                    endunless

                    assign line_color_name = ''
                    assign line_color_hex = ''
                    unless has_color_option
                      assign tag_key = line_product.tags | join: '~|~' | downcase | prepend: '~|~' | append: '~|~'
                      for row in color_table
                        assign parts = row | strip | split: '='
                        assign candidate = parts[0] | strip
                        assign candidate_hex = parts[1] | strip
                        if candidate != blank and candidate_hex != blank
                          assign candidate_key = candidate | downcase | prepend: '~|~' | append: '~|~'
                          if tag_key contains candidate_key
                            assign line_color_name = candidate
                            assign line_color_hex = candidate_hex
                            break
                          endif
                        endif
                      endfor
                    endunless
                  -%}

                  {%- if line_color_name != blank or line_product.has_only_default_variant == false -%}
                    <div class="cart-items__options">
                      {%- if line_color_name != blank -%}
                        <div class="cart-items__option">
                          <p class="cart-items__option-label">Color: {{ line_color_name }}</p>
                          <div class="cart-items__values">
                            <span
                              class="cart-items__value cart-items__value--circle cart-items__value--static"
                              style="--ie-swatch: {{ line_color_hex }};"
                            >
                              <span class="cart-items__value-face"></span>
                            </span>
                          </div>
                        </div>
                      {%- endif -%}

                      {%- unless line_product.has_only_default_variant -%}
                        {%- for option in line_product.options_with_values -%}
                          {%- liquid
                            assign opt_index = forloop.index
                            assign option_key = option.name | downcase

                            comment
                              Размер выбирают по надписи, всё остальное — глазами,
                              поэтому размеры рисуем прямоугольниками, а прочее
                              кружками. Правило то же, что на странице товара.
                            endcomment
                            assign is_size = false
                            for word in size_words
                              assign needle = word | strip
                              if needle != blank and option_key contains needle
                                assign is_size = true
                                break
                              endif
                            endfor

                            assign current_value = cur1
                            if opt_index == 2
                              assign current_value = cur2
                            elsif opt_index == 3
                              assign current_value = cur3
                            endif
                          -%}

                          <fieldset
                            class="cart-items__option"
                            data-ie-cart-option-group
                            data-ie-current-value="{{ current_value | escape }}"
                          >
                            <legend class="cart-items__option-label">
                              {{ option.name }}: {{ current_value }}
                            </legend>

                            <div class="cart-items__values">
                              {%- for value in option.values -%}
                                {%- liquid
                                  comment
                                    Какой вариант получится, если сменить ТОЛЬКО эту
                                    опцию: остальные держим как в строке корзины.
                                    Ищем его здесь, чтобы браузеру не пришлось знать
                                    ничего про матрицу вариантов — в разметку уходит
                                    готовый id.
                                  endcomment
                                  assign want1 = cur1
                                  assign want2 = cur2
                                  assign want3 = cur3
                                  if opt_index == 1
                                    assign want1 = value.name
                                  elsif opt_index == 2
                                    assign want2 = value.name
                                  else
                                    assign want3 = value.name
                                  endif

                                  assign target_id = ''
                                  assign target_available = false
                                  assign target_image = ''
                                  for candidate in line_product.variants
                                    if candidate.option1 == want1 and candidate.option2 == want2 and candidate.option3 == want3
                                      assign target_id = candidate.id
                                      assign target_available = candidate.available
                                      assign target_image = candidate.image
                                      break
                                    endif
                                  endfor

                                  assign fill = ''
                                  unless is_size
                                    if value.swatch.color
                                      assign fill = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                                    elsif value.swatch.image
                                      assign fill = value.swatch.image | image_url: width: 80 | prepend: 'url(' | append: ')'
                                    elsif target_image != blank
                                      assign fill = target_image | image_url: width: 80 | prepend: 'url(' | append: ')'
                                    endif
                                  endunless

                                  assign is_current = false
                                  if value.name == current_value
                                    assign is_current = true
                                  endif
                                -%}

                                <label
                                  class="cart-items__value cart-items__value--{% if is_size %}box{% else %}circle{% endif %}{% unless target_available %} cart-items__value--out{% endunless %}"
                                  {% if fill != blank %}style="--ie-swatch: {{ fill }};"{% endif %}
                                >
                                  <input
                                    type="radio"
                                    name="ie-cart-option-{{ item.key }}-{{ opt_index }}"
                                    value="{{ value.name | escape }}"
                                    data-ie-cart-option
                                    data-line-key="{{ item.key }}"
                                    data-quantity="{{ item.quantity }}"
                                    data-variant-id="{{ target_id }}"
                                    {% if is_current %}checked{% endif %}
                                    {% if target_id == blank or target_available == false %}disabled{% endif %}
                                  >
                                  <span class="cart-items__value-face">
                                    {%- if is_size -%}
                                      {{ value.name }}
                                    {%- else -%}
                                      <span class="visually-hidden">{{ value.name }}</span>
                                    {%- endif -%}
                                  </span>
                                </label>
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- endfor -%}
                      {%- endunless -%}
                    </div>
                  {%- endif -%}

                  {%- comment -%}
                    Свойства строки, план подписки и скидки заказа. Значения
                    опций отсюда убраны — они теперь показаны переключателем выше.
                  {%- endcomment -%}
                  <div class="cart-items__variants-wrapper">
                    {%- liquid
                      assign has_visible_properties = false
                      for property in item.properties
                        assign property_first_char = property.first | slice: 0
                        if property.last != blank and property_first_char != '_'
                          assign has_visible_properties = true
                          break
                        endif
                      endfor
                    -%}
                    {%- if has_visible_properties -%}
                      <dl class="cart-items__properties">
                        {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            <div class="cart-items__property">
                              <dt>{{ property.first }}:</dt>
                              <dd>
                                {%- if property.last contains '/uploads/' -%}
                                  <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
                                {%- else -%}
                                  {{ property.last }}
                                {%- endif -%}
                              </dd>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </dl>
                    {%- endif -%}

                    {%- if item.selling_plan_allocation -%}
                      <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul
                        class="list-unstyled"
                        role="list"
                      >
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li>{{ discount.discount_application.title | escape }}</li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                  {%- comment -%}
                    Выбора количества в строке нет — как и на странице товара.
                    Осталось только удаление; чтобы взять две штуки, товар
                    добавляют дважды.
                  {%- endcomment -%}
                  <div class="cart-items__actions">
                    <button
                      class="button cart-items__remove"
                      type="button"
                      aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                      on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                      {% assign can_remove = item.instructions.can_remove | default: true, allow_false: true %}
                      {% if can_remove == false %}
                        hidden
                      {% endif %}
                    >
                      {{- 'icon-delete.svg' | inline_asset_content -}}
                      <span class="visually-hidden">{{ 'accessibility.remove' | t }}</span>
                    </button>
                  </div>
                </td>
                <td
                  class="cart-items__error hidden"
                  role="cell"
                  ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                  headers="quantity"
                >
                  <div
                    class="cart-item__error"
                    role="alert"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-item__error-text cart-primary-typography"
                      ref="cartItemError-{{ item.index | plus: 1 }}"
                    ></small>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {% for item in cart.items %}
          {%- liquid
            assign cart_disclosure_unique_id = 'page-' | append: item.index
            if context == 'drawer'
              assign cart_disclosure_unique_id = 'drawer-' | append: item.index
            endif
          -%}
          {% render 'cart-disclosure-tooltip',
            product: item.product,
            unique_id: cart_disclosure_unique_id,
            mode: 'dialog'
          %}
        {% endfor %}
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-items {
    --cart-item-media-width-min: 2.5rem;
    --cart-item-media-width-max: 7.5rem;

    container-name: cart-items;
    container-type: inline-size;
    width: 100%;
  }

  .cart-items-disabled {
    pointer-events: none;
  }

  .cart-items__wrapper {
    display: flex;
    flex-direction: column;
  }

  .cart-page--empty .cart-items__wrapper {
    align-items: center;
    margin-block-start: 0;
    text-align: center;
  }

  .cart-items__wrapper--drawer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cart-items__table {
    width: 100%;
    border-spacing: 0;
  }

  .cart-items__table * {
    margin: 0;
  }

  /*
   * Строка — две колонки: фотография и всё остальное. Колонок количества
   * и итога по строке больше нет, поэтому и сетка простая: содержимое
   * само выстраивается сверху вниз, как на странице товара.
   */
  .cart-items__table-row {
    display: grid;
    grid-template-columns: clamp(2.5rem, 15cqi, 7.5rem) minmax(0, 1fr);
    grid-template-areas:
      'media details'
      'media error';
    column-gap: var(--gap-md);
    align-items: start;
    padding-bottom: var(--cart-items-gap);
    margin-bottom: var(--margin-lg);
  }

  .cart-items__details {
    grid-area: details;
    min-width: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .cart-items__product-info {
    min-width: 0;
  }

  .cart-items__table-row.cart-items__nested-line td:first-child {
    width: 60%;
    justify-self: right;
  }

  html:active-view-transition-type(page-navigation) .cart-items__table-row {
    /* stylelint-disable-next-line declaration-no-important */
    view-transition-name: none !important;
  }

  .cart-items__table-row.removing {
    overflow: hidden;
    animation: removeRow calc(var(--animation-speed) * 2) var(--animation-easing) forwards;
    animation-delay: var(--animation-speed);
  }

  @keyframes removeRow {
    0% {
      height: var(--row-height);
    }

    100% {
      opacity: 0;
      height: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      border-color: transparent;
    }
  }

  .cart-items__table-row.adding {
    interpolate-size: allow-keywords;
    overflow: hidden;
    animation: addRow calc(var(--animation-speed) * 2) var(--animation-easing) forwards;
  }

  @keyframes addRow {
    0% {
      opacity: 0;
      height: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      border-color: transparent;
    }

    100% {
      opacity: 1;
      height: auto;
    }
  }

  .cart-items__table-row:last-child {
    padding-bottom: 0;
  }

  .cart-items--dividers .cart-items__table-row {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--cart-items-gap);
  }

  .cart-items--dividers .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-items--dividers .cart-items__table-row:last-of-type {
    border-block-end: none;
    padding-block-end: 0;
    margin-bottom: 0;
  }

  .cart-items__details > * + *,
  .cart-items__bundle li {
    margin-block-start: var(--margin-3xs);
  }

  .cart-items__details * {
    font-size: var(--font-size--sm);
  }

  .cart-items__details a {
    text-decoration: none;
  }

  .cart-items__title-row {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    max-width: 100%;
    min-width: 0;
  }

  .cart-items__title {
    font-size: var(--font-size--md);
    color: var(--color-foreground);
    text-transform: var(--product-title-case);
    display: block;
    margin-block-start: 0;
    min-width: 0;
    overflow-wrap: break-word;
  }

  /*
   * Бренд над названием и размер скидки. Разметку добавили выше в этом же
   * файле, поэтому и правила держим рядом с ней, а не в ie-design.css:
   * при обновлении темы файл заменится целиком — и стили уйдут вместе
   * с элементами, которых после замены не будет.
   *
   * Насыщенность, шрифт и цвет бренду задаёт .product-designer из
   * ie-design.css — тот же класс, что в карточках и на странице товара.
   * Здесь возвращаем только кегль: правило .cart-items__details * выше
   * сбивает его на sm, и без этого бренд не отличался бы от названия.
   */
  .cart-items__details .cart-items__vendor {
    font-size: var(--ie-vendor-size, 1rem);
    margin-block-end: var(--margin-3xs);
  }

  /*
   * Цена. Наша — чёрным и в полную силу: у .cart-items__details цвет
   * приглушён до 70%, и без явного правила цена читалась бы бледнее
   * названия. Прежняя — серым и зачёркнутая, процент — бордо.
   * Всё в одной строке, как на странице товара.
   */
  .cart-items__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: var(--margin-3xs) 0;
    letter-spacing: 0.04em;
  }

  .cart-items__details .cart-items__price-current {
    color: var(--ie-ink, #111);
  }

  .cart-items__details .cart-items__price-compare {
    color: var(--ie-muted, #9a9a9a);
  }

  .cart-items__details .cart-items__discount {
    color: var(--brand-accent, var(--ie-bordo, #4e070d));
    white-space: nowrap;
  }

  /*
   * Цвет и размер под ценой. Визуальный язык взят со страницы товара
   * (sections/ie-product.liquid): размеры — прямоугольники с надписью,
   * прочие опции — кружки. Классы свои: правила той секции живут в её
   * собственном stylesheet и до корзины не достают.
   */
  .cart-items__options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block-start: var(--margin-xs);
  }

  .cart-items__option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .cart-items__option-label {
    display: block;
    margin: 0;
    padding: 0;
    letter-spacing: 0.06em;
  }

  .cart-items__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.45rem;
  }

  .cart-items__value input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cart-items__value-face {
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }

  .cart-items__value input:focus-visible + .cart-items__value-face {
    outline: 2px solid var(--ie-ink, #111);
    outline-offset: 2px;
  }

  .cart-items__value--box .cart-items__value-face {
    min-width: 2.5rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--ie-line, #e5e1da);
    letter-spacing: 0.06em;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .cart-items__value--box input:checked + .cart-items__value-face {
    border-color: var(--ie-ink, #111);
  }

  /* Разобранный размер видно, но выбрать нельзя: корзина его не примет. */
  .cart-items__value--out .cart-items__value-face {
    cursor: not-allowed;
  }

  .cart-items__value--box.cart-items__value--out .cart-items__value-face {
    color: var(--ie-muted, #9a9a9a);
    text-decoration: line-through;
  }

  .cart-items__value--circle .cart-items__value-face {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--ie-swatch, #ddd);
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
    transition: box-shadow 0.2s ease;
  }

  .cart-items__value--circle input:checked + .cart-items__value-face {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12), 0 0 0 1px #fff, 0 0 0 2px var(--ie-ink, #111);
  }

  .cart-items__value--circle.cart-items__value--out .cart-items__value-face {
    opacity: 0.35;
  }

  /* Цвет из тега показываем, но не предлагаем выбрать: вариант всего один. */
  .cart-items__value--static .cart-items__value-face {
    cursor: default;
  }

  .cart-items__variants {
    display: block;
  }

  .cart-items__variant {
    display: inline;
  }

  .cart-items__variant dt,
  .cart-items__variant dd {
    display: inline;
    margin: 0;
  }

  .cart-items__actions {
    margin-block-start: var(--margin-xs);
  }

  .cart-items__remove {
    background-color: transparent;
    color: var(--color-foreground);
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    justify-content: center;
    box-shadow: none;
    padding: 0;
    margin-inline-start: calc(-1 * var(--padding-xs));
  }

  .cart-items__media {
    grid-area: media;
    padding: 0;
  }

  .cart-items__media-container {
    display: flex;
    aspect-ratio: var(--ratio);
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .cart-items__media-image {
    aspect-ratio: inherit;
    object-fit: cover;
    object-position: center center;
    width: 100%;
    height: auto;
  }

  .cart-items__empty-button {
    margin-top: var(--margin-md);
    margin-inline: auto;
    padding-inline: var(--padding-4xl);
    padding-block: var(--padding-lg);
  }

  /* Error message */
  .cart-items__error {
    display: flex;
    align-items: flex-start;
    width: 100%;
    grid-area: error;
    margin-block-start: var(--margin-xs);
    opacity: 1;
    overflow: hidden;
    transform: translateY(0);
    transition: opacity var(--drawer-animation-speed) var(--animation-easing),
      transform var(--drawer-animation-speed) var(--animation-easing);

    @starting-style {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .cart-item__error {
    display: flex;
    align-items: flex-start;
    width: 100%;
    font-size: var(--font-size--sm);
    padding-block: var(--padding-2xs);
  }

  .cart-item__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
    margin-block-start: var(--margin-3xs);
  }

  .cart__subtotal-container,
  .cart__total-container {
    display: flex;
    flex-direction: column;
  }

  .cart__total-container {
    row-gap: var(--gap-2xs);

    &.cart__total-container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart__subtotal-container:empty {
    display: none;
  }

  .cart__summary-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart__subtotal-container, .cart__total-container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart__subtotal-container,
  .cart__subtotal-container * {
    font-size: var(--font-size--sm);
  }

  .cart__total {
    font-weight: var(--font-weight-bold);
  }

  .cart__total-label {
    font-size: var(--font-size--sm);
  }

  .cart__total-value {
    font-size: var(--font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-primary-typography {
    font-family: var(--cart-primary-font-family);
    font-style: var(--cart-primary-font-style);
    font-weight: var(--cart-primary-font-weight);
  }

  .cart-secondary-typography {
    font-family: var(--cart-secondary-font-family);
    font-style: var(--cart-secondary-font-style);
    font-weight: var(--cart-secondary-font-weight);
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__additional-checkout-buttons {
    width: 100%;
  }

  shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-inline-alignment: center;
    --shopify-accelerated-checkout-button-border-radius: var(--style-border-radius-buttons-primary);
    --shopify-accelerated-checkout-row-gap: var(--checkout-button-gap, 10px);
  }

  /* Remove animation */
  .remove-icon-bottom,
  .remove-icon-top {
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .cart-items__remove:hover .remove-icon-top {
    transform: translate(calc(-1 * var(--icon-stroke-width)), var(--icon-stroke-width)) rotate(-15deg);
  }

  .cart-items__remove:is(:hover, :active) .remove-icon-bottom {
    transform: translateY(var(--icon-stroke-width));
  }

  .cart-items__table-row.removing .remove-icon-bottom {
    transform: translateY(0);
  }

  .cart-items__table-row.removing .remove-icon-top {
    animation: removeButtonClickedIconTop var(--animation-speed) var(--animation-easing) forwards;
  }

  @keyframes removeButtonClickedIconTop {
    50% {
      transform: translate(0, calc(-1 * var(--icon-stroke-width)));
    }

    100% {
      transform: translate(0, 0);
    }
  }

  .cart-items__properties {
    display: block;
    margin-block-start: var(--margin-2xs);
  }

  .cart-items__property {
    display: block;
  }

  .cart-items__properties dt,
  .cart-items__properties dd {
    display: inline;
    margin: 0;
    overflow-wrap: break-word;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .cart-items__empty-button,
      .cart__checkout-button {
        view-transition-name: cart-drawer-primary-action;

        & > .button-text {
          view-transition-name: cart-drawer-primary-action-text;
        }
      }
    }
  }

  ::view-transition-old(cart-drawer-primary-action-text),
  ::view-transition-new(cart-drawer-primary-action-text) {
    height: 100%;
    object-fit: none;
    overflow: clip;
    overflow-clip-margin: 1em;
  }

  ::view-transition-old(cart-drawer-primary-action-text) {
    animation: cart-drawer-primary-action-text var(--animation-speed) var(--animation-easing) reverse forwards;
  }
  ::view-transition-new(cart-drawer-primary-action-text) {
    animation: cart-drawer-primary-action-text var(--animation-speed) var(--animation-easing) forwards;
  }

  ::view-transition-old(cart-drawer-primary-action),
  ::view-transition-new(cart-drawer-primary-action) {
    height: 100%;
  }

  ::view-transition-group(cart-drawer-primary-action-text),
  ::view-transition-group(cart-drawer-primary-action) {
    animation-duration: var(--spring-d300-b0-duration);
    animation-timing-function: var(--spring-d300-b0-easing);
  }

  @keyframes cart-drawer-primary-action-text {
    from {
      filter: blur(3px);
      opacity: 0;
    }
    to {
      filter: none;
      opacity: 1;
    }
  }
{% endstylesheet %}
