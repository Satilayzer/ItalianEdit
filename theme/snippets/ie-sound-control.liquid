{% doc %}
  Управление звуком витрины в шапке: динамик глушит и включает весь звук
  на сайте, ползунок задаёт громкость. Стоит на месте бывшего переключателя
  стран и валют.

  Логика — в assets/ie-sound.js.
{% enddoc %}

<script src="{{ 'ie-sound.js' | asset_url }}" type="module" fetchpriority="low"></script>

<ie-sound-control
  class="ie-sound"
  data-muted="true"
  data-label-on="{{ 'Включить звук' | escape }}"
  data-label-off="{{ 'Выключить звук' | escape }}"
>
  <button
    type="button"
    class="ie-sound__toggle"
    data-sound-toggle
    aria-pressed="false"
    aria-label="{{ 'Включить звук' | escape }}"
  >
    <svg class="ie-sound__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path
        class="ie-sound__speaker"
        d="M4 9.5h3.2L12 5.5v13l-4.8-4H4a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5Z"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linejoin="round"
      />
      <path class="ie-sound__wave" d="M15.2 9.4a3.6 3.6 0 0 1 0 5.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path class="ie-sound__wave ie-sound__wave--far" d="M17.6 7.2a7 7 0 0 1 0 9.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path class="ie-sound__cross" d="M15.6 9.6l5 4.8m0-4.8l-5 4.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </button>

  <label class="ie-sound__volume">
    <span class="ie-sound__label">{{ 'Громкость' }}</span>
    {%- comment -%}
      orient — для Firefox: он до сих пор поворачивает ползунок только по
      атрибуту. Остальные браузеры разворачивают его через writing-mode.
    {%- endcomment -%}
    <input
      class="ie-sound__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="40"
      orient="vertical"
      data-sound-volume
    >
  </label>
</ie-sound-control>

{% stylesheet %}
  .ie-sound {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: currentcolor;
  }

  .ie-sound__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    line-height: 0;
  }

  .ie-sound__icon {
    width: 20px;
    height: 20px;
  }

  /* Волны видно, когда звук включён; перечёркнутый динамик — когда выключен. */
  .ie-sound__cross {
    opacity: 0;
  }

  .ie-sound[data-muted='true'] .ie-sound__wave {
    opacity: 0;
  }

  .ie-sound[data-muted='true'] .ie-sound__cross {
    opacity: 1;
  }

  .ie-sound__wave,
  .ie-sound__cross {
    transition: opacity 0.2s ease;
  }

  /*
   * Ползунок висит отдельной панелью под динамиком и разворачивается вниз.
   * Раньше он раздвигался вбок и сдвигал соседние иконки шапки; так ряд
   * стоит на месте, что бы ни делал ползунок.
   *
   * На тач-устройствах наведения нет, поэтому панель открывается ещё и по
   * фокусу: касание динамика и глушит звук, и показывает громкость.
   */
  .ie-sound__volume {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: 5;
    display: flex;
    justify-content: center;
    padding: 10px 7px;
    border: 1px solid var(--ie-line, #e5e1da);
    background: #fff;
    translate: -50% -4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, translate 0.2s ease;
  }

  .ie-sound:hover .ie-sound__volume,
  .ie-sound:focus-within .ie-sound__volume {
    opacity: 1;
    pointer-events: auto;
    translate: -50% 0;
  }

  /*
   * Мостик через зазор между динамиком и панелью: без него курсор по дороге
   * вниз выходит из элемента и панель успевает закрыться.
   */
  .ie-sound__volume::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: 8px;
  }

  .ie-sound__label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /*
   * Размеры задаём физическими свойствами: при writing-mode: vertical-*
   * inline-size — это высота, и логические свойства читались бы наоборот.
   * direction: rtl ставит тихо внизу, громко вверху.
   */
  .ie-sound__range {
    writing-mode: vertical-lr;
    direction: rtl;
    -webkit-appearance: slider-vertical;
    width: 14px;
    height: 72px;
    margin: 0;
    accent-color: currentcolor;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .ie-sound__volume {
      transition: none;
    }
  }
{% endstylesheet %}
