{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}

{%- comment -%}
  Макет корзины (ноябрь 2026). Сниппет общий для страницы и шторки;
  шторку узнаём по id её секции. На странице — заголовок, строки
  Subtotal / You save / Shipping и пункты доверия; в шторке — коротко:
  экономия, итог и одна строка про доставку и пошлины.

  «You save» — сумма по строкам: (зачёркнутая − наша) × количество, только
  для строк, где скидка видна покупателю (порог из ie-discount-percent),
  иначе сумма разошлась бы с тем, что зачёркнуто в строках.

  Доставка по США — по политике: бесплатно от $70, иначе $8 (тариф
  настроен в Shopify, здесь только подпись; поменяете тариф — поправьте
  ie_free_from и ie_us_rate).
{%- endcomment -%}
{%- liquid
  assign is_drawer = false
  if section_id == 'cart-drawer-section'
    assign is_drawer = true
  endif

  assign ie_save = 0
  assign ships_from_eu = false
  for item in cart.items
    assign ie_compare = item.variant.compare_at_price | default: 0
    if ie_compare > item.original_price
      capture ie_pct
        render 'ie-discount-percent', compare_at: ie_compare, price: item.original_price
      endcapture
      assign ie_pct = ie_pct | strip
      if ie_pct != blank
        assign ie_line_save = ie_compare | minus: item.original_price | times: item.quantity
        assign ie_save = ie_save | plus: ie_line_save
      endif
    endif
    if item.product.tags contains 'EU'
      assign ships_from_eu = true
    endif
  endfor

  assign ie_free_from = 7000
  assign ie_us_rate = 800
  assign ie_free_us = false
  if cart.total_price >= ie_free_from
    assign ie_free_us = true
  endif
-%}

{%- unless is_drawer -%}
  <h2 class="cart-summary__heading">Order summary</h2>
{%- endunless -%}

<div class="cart-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <span class="cart-totals__item cart-totals__original">
        <span class="cart-totals__original-label">{{ 'content.cart_subtotal' | t }}</span>
        <span
          class="cart-totals__original-value cart-secondary-typography"
          data-testid="cart-subtotal-value"
        >
          {{- cart.items_subtotal_price | money -}}
        </span>
      </span>
      <ul
        class="cart-discounts"
        role="list"
        aria-label="{{ 'content.discounts' | t }}"
      >
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="cart-discounts__item">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount.title | escape }}
            </span>
            <span class="cart-discounts__value cart-secondary-typography"
              >-{{ discount.total_allocated_amount | money -}}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="cart-totals__lines cart-primary-typography">
    {%- if is_drawer == false and cart.cart_level_discount_applications.size == 0 -%}
      <div class="cart-totals__line">
        <span>Subtotal · {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</span>
        <span>{{ cart.items_subtotal_price | money }}</span>
      </div>
    {%- endif -%}
    {%- if ie_save > 0 -%}
      <div class="cart-totals__line cart-totals__line--save">
        <span>You save</span>
        <span>&#8722;{{ ie_save | money }}</span>
      </div>
    {%- endif -%}
    {%- unless is_drawer -%}
      <div class="cart-totals__line">
        <span>Shipping to the US</span>
        <span>{% if ie_free_us %}Free{% else %}{{ ie_us_rate | money }}{% endif %}</span>
      </div>
      <div class="cart-totals__line cart-totals__line--muted">
        <span>Other destinations</span>
        <span>At checkout</span>
      </div>
    {%- endunless -%}
  </div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}
      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}
      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor

          assign discount_codes = discount_codes | uniq

          # Evaluate the boolean expression for the disclosure state
          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        %}

        {% capture cart_discount_accordion_children %}
          <details
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">{{ 'content.discount' | t }}</span>

              <span class="cart-totals__icon">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>

            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component
                  {% if section_id != blank %}
                    data-section-id="{{ section_id }}"
                  {% endif %}
                >
                  <div class="cart-discount__content">
                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>
                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                        data-skip-node-update
                      >
                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="cart-discount__codes">
                    {% for discount_code in discount_codes %}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          {{ discount_code }}
                        </p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: cart_discount_accordion_children, class: 'cart-discount' %}
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif
  -%}

  <div class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}">
    <span
      class="cart-totals__item cart-totals__total"
      role="status"
    >
      <span class="cart-totals__total-label cart-primary-typography">{{ 'content.cart_estimated_total' | t }}</span>
      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart-totals__total-value cart-secondary-typography"
        {% comment %} Used by payment_terms web component {% endcomment %}
        data-testid="cart-total-value"
        data-cart-subtotal
      >
        {{ total_price }}
      </text-component>
    </span>
    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
    {%- if is_drawer -%}
      <div class="cart-totals__item cart-totals__tax-note cart-totals__drawer-note cart-primary-typography">
        <small>
          {%- if ie_free_us -%}Free US shipping{%- else -%}US shipping {{ ie_us_rate | money }}{%- endif %}
          · taxes at checkout
          {%- if ships_from_eu %} · duties paid on delivery{% endif -%}
        </small>
      </div>
    {%- else -%}
      <div class="cart-totals__item cart-totals__tax-note cart-primary-typography">
        {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="cart__ctas">
  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >
    <span class="button-text">
      <svg class="cart__checkout-lock" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      {{ 'content.checkout' | t }}
    </span>
  </button>

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    {%- unless is_drawer -%}
      <p class="cart__ctas-divider" aria-hidden="true"><span>or pay with</span></p>
    {%- endunless -%}
    <div
      class="
        additional-checkout-buttons
        additional-checkout-buttons--horizontal
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}

  {%- if is_drawer -%}
    <a class="cart__view-cart" href="{{ routes.cart_url }}">View full cart</a>
  {%- endif -%}
</div>

{%- unless is_drawer -%}
  {%- if ships_from_eu -%}
    <p class="cart-summary__duties cart-primary-typography">
      Ships from the EU. US import duties may apply and are paid by the recipient on delivery.
    </p>
  {%- endif -%}

  <ul class="cart-summary__trust cart-primary-typography">
    <li>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
      100% authentic, sourced from boutiques in Italy and Europe
    </li>
    <li>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      Secure checkout by Shopify
    </li>
    <li>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9h12a4 4 0 0 1 0 8H9"/><path d="M8 5L4 9l4 4"/></svg>
      Returns within 5 days of delivery
    </li>
  </ul>

  {%- comment -%}
    Телефон: итог и кнопка оформления прилипают к низу экрана, пока
    покупатель листает список. Кнопка — та же отправка формы корзины
    (form="cart-form", name="checkout"), без id: id занят основной.
  {%- endcomment -%}
  <div class="cart-sticky-bar">
    <div class="cart-sticky-bar__total">
      <span class="cart-sticky-bar__label">Total</span>
      <span class="cart-sticky-bar__value">{{ cart.total_price | money }}</span>
    </div>
    <button
      type="submit"
      class="cart-sticky-bar__button"
      name="checkout"
      form="cart-form"
      {% if cart == empty %}
        disabled
      {% endif %}
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
      {{ 'content.checkout' | t }}
    </button>
  </div>
{%- endunless -%}

{% stylesheet %}
  /* ---------- Макет корзины (ноябрь 2026): итоги ---------- */

  .cart-summary__heading {
    width: 100%;
    margin: 0;
    font-family: var(--ie-display, var(--font-heading--family));
    font-weight: 400;
    font-size: 1.625rem;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  .cart-totals__lines {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
  }

  .cart-totals__lines:empty {
    display: none;
  }

  .cart-totals__line {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .cart-totals__line--save {
    color: var(--brand-accent, var(--ie-bordo, #4e070d));
    font-weight: 600;
  }

  .cart-totals__line--muted {
    color: #595959;
    font-size: 0.875rem;
  }

  .cart-totals__total-value {
    font-family: var(--ie-display, var(--font-heading--family));
    font-weight: 400;
  }

  .cart__ctas .cart__checkout-button {
    border-radius: 0;
    background: var(--brand-accent, var(--ie-bordo, #4e070d));
    border-color: var(--brand-accent, var(--ie-bordo, #4e070d));
    color: #fff;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Тема растягивает .button-text на всю ширину кнопки (display: flex),
     поэтому замок с надписью центруем явно — иначе они прижаты влево. */
  .cart__ctas .cart__checkout-button .button-text {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
  }

  .cart__ctas-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #595959;
  }

  .cart__ctas-divider::before,
  .cart__ctas-divider::after {
    content: '';
    flex: 1 1 0;
    height: 1px;
    background: #e3dbd4;
  }

  /*
   * Кнопки Shop Pay / PayPal / Apple Pay — в один ряд, а не друг под
   * другом во всю ширину: так основная кнопка «Check out» остаётся главной.
   * Сами кнопки Shopify рисует в закрытом shadow DOM, поэтому ряд включается
   * не нашей сеткой, а штатным классом additional-checkout-buttons--horizontal
   * (см. разметку выше); здесь — только высота и скругление.
   */
  .additional-checkout-buttons shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-button-block-size: 44px;
    --shopify-accelerated-checkout-button-border-radius: 4px;
    --shopify-accelerated-checkout-row-gap: 8px;

  }

  .cart__view-cart {
    justify-self: center;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ie-ink, #111);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cart-summary__duties {
    width: 100%;
    margin: 0;
    padding: 0.75rem 0.875rem;
    background: #fff;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .cart-summary__trust {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: #595959;
  }

  .cart-summary__trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cart-summary__trust svg {
    flex: 0 0 auto;
  }

  .cart-sticky-bar {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .cart-page .cart-summary__inner {
      padding: 1.375rem 1.125rem;
      background: #f7f3ef;
    }

    .cart-sticky-bar {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      gap: 0.875rem;
      padding: 0.75rem 1rem calc(1rem + env(safe-area-inset-bottom));
      background: #fff;
      border-top: 1px solid #e3dbd4;
      box-shadow: 0 -8px 20px rgb(0 0 0 / 0.06);
    }

    body:has(.cart-sticky-bar) {
      padding-bottom: 5.5rem;
    }

    .cart-sticky-bar__total {
      display: flex;
      flex-direction: column;
      flex: 0 0 auto;
    }

    .cart-sticky-bar__label {
      font-size: 0.75rem;
      color: #595959;
    }

    .cart-sticky-bar__value {
      font-family: var(--ie-display, var(--font-heading--family));
      font-size: 1.375rem;
    }

    .cart-sticky-bar__button {
      flex: 1 1 auto;
      height: 3.25rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border: 0;
      background: var(--brand-accent, var(--ie-bordo, #4e070d));
      color: #fff;
      font: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      cursor: pointer;
    }
  }

  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }
{% endstylesheet %}
