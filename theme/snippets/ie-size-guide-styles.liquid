{%- doc -%}
  Оформление шторки «Size guide» — таблицы размеров.

  @example
  {% render 'ie-size-guide-styles' %}
{%- enddoc -%}

{%- comment -%}
  Шторку рисует sections/ie-product.liquid, а показывают её двое: сама
  страница товара и быстрая покупка в каталоге (assets/ie-quick-add.js
  берёт готовую шторку со страницы товара). В {% stylesheet %} секции
  товара эти правила не доезжали бы до каталога — там секция не
  рендерится. Поэтому отдельный сниппет: его рендерят и секция товара,
  и snippets/quick-add-modal.liquid.
{%- endcomment -%}

{% stylesheet %}
  /*
   * Шторка во всю высоту у правого края. Поля и размеры у <dialog> свои —
   * снимаем, как и у просмотра фотографий; закрытый диалог прячем совсем.
   */
  .ie-pdp__guide {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(32rem, 100%);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #fff;
    color: var(--ie-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .ie-pdp__guide:not([open]) {
    display: none;
  }

  .ie-pdp__guide[open] {
    animation: ie-guide-in 0.3s ease;
  }

  .ie-pdp__guide::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  @keyframes ie-guide-in {
    from {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ie-pdp__guide[open] {
      animation: none;
    }
  }

  /*
   * Содержимое во всю высоту шторки: клик по пустому месту под таблицей
   * должен попадать в него, а не в сам диалог — клик по диалогу скрипт
   * считает кликом по затемнению и закрывает шторку.
   */
  .ie-pdp__guide-inner {
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .ie-pdp__guide-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .ie-pdp__guide-title {
    margin: 0;
    font-family: var(--ie-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ie-ink);
  }

  /* 44px по высоте — минимальная цель нажатия, как у остальных кнопок. */
  .ie-pdp__guide-close {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--ie-sans);
    font-size: 0.875rem;
    color: var(--ie-ink);
    cursor: pointer;
  }

  .ie-pdp__guide-close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ie-pdp__guide-intro {
    margin-bottom: 2rem;
    font-family: var(--ie-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: #555;
  }

  .ie-pdp__guide-intro p {
    margin: 0 0 0.75em;
  }

  .ie-pdp__guide-brand {
    margin: 0 0 0.875rem;
    font-family: var(--ie-sans);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ie-muted);
  }

  .ie-pdp__guide-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--ie-sans);
    font-size: 0.875rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .ie-pdp__guide-table th,
  .ie-pdp__guide-table td {
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--ie-line);
  }

  .ie-pdp__guide-table th {
    font-weight: 600;
    background: #f2f2f2;
  }

  /* Строка размера, выбранного на странице. */
  .ie-pdp__guide-table tr[data-current] td {
    background: var(--ie-cream);
    font-weight: 600;
  }
{% endstylesheet %}
