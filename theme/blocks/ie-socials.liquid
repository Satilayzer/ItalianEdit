{%- comment -%}
  Колонка «Our Socials» в подвале — рядом с тремя колонками меню.

  Зачем свой блок, а не штатный menu со своим меню в админке: menu печатает
  ссылки без target, и соцсеть открывалась бы вместо магазина. Штатный
  social-links рисует ряд значков без подписей, а нужна такая же колонка
  текстом, как соседние.

  Разметку и классы берём у blocks/menu.liquid (menu__heading, h5,
  menu__item, paragraph): шрифт, вес заголовка и шаг между пунктами
  подтягиваются из тех же правил, и колонка не отличается от соседних.
  Пустая ссылка в настройках — пункта нет. Ключ ссылки (instagram, …)
  заодно имя значка в snippets/icon.liquid.
{%- endcomment -%}

{%- liquid
  assign links = 'instagram:Instagram,pinterest:Pinterest,facebook:Facebook,telegram:Telegram' | split: ','
  assign heading = block.settings.heading
-%}

<div class="menu ie-socials" {{ block.shopify_attributes }}>
  <div class="menu__details" style="--spacing--size: {{ block.settings.menu_spacing }}px;">
    {%- if heading != blank -%}
      <p class="menu__heading h5">
        <span class="menu__heading__default">{{ heading }}</span>
      </p>
    {%- endif -%}
    <nav class="details-content" aria-label="{{ heading | default: 'Social media' | escape }}">
      <ul class="list-unstyled">
        {%- for pair in links -%}
          {%- liquid
            assign parts = pair | split: ':'
            assign url = block.settings[parts[0]]
          -%}
          {%- if url != blank -%}
            <li class="menu__item paragraph">
              <a class="ie-socials__link" href="{{ url }}" target="_blank" rel="noopener noreferrer">
                <svg
                  class="ie-socials__icon"
                  aria-hidden="true"
                  focusable="false"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                >
                  {%- render 'icon', icon: parts[0] -%}
                </svg>
                {{- parts[1] -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</div>

{% stylesheet %}
  /*
   * У штатной колонки заголовок — <summary>, и base.css даёт ему
   * padding-block: var(--padding-sm). У нас вместо summary абзац (сворачивать
   * колонку незачем), поэтому поля абзаца снимаем, а те же отступы ставим
   * сами — иначе заголовок и пункты вставали выше соседних колонок.
   */
  .ie-socials .menu__heading {
    margin: 0;
    padding-block: var(--padding-sm);
  }

  .ie-socials__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  /*
   * Значки из snippets/icon.liquid — те же, что у штатного social-links.
   * fill задаём явно: у путей там своего fill нет, а по умолчанию в SVG он
   * чёрный — значок не подхватил бы цвет ссылки. Размер в em — от шрифта
   * пункта, чтобы значок не перерастал строку.
   */
  .ie-socials__icon {
    display: block;
    flex-shrink: 0;
    width: 1.2em;
    height: 1.2em;
    fill: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IE — Соцсети",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Заголовок", "default": "OUR SOCIALS" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },
    { "type": "url", "id": "facebook", "label": "Facebook" },
    { "type": "url", "id": "telegram", "label": "Telegram" },
    { "type": "range", "id": "menu_spacing", "label": "Шаг между пунктами", "unit": "px", "min": 0, "max": 50, "step": 1, "default": 12 }
  ],
  "presets": [{ "name": "IE — Соцсети" }]
}
{% endschema %}
