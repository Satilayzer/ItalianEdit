

{% doc %}
  Cart Title

  Renders the cart title or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state

  @example
  {% render 'cart-title', force_empty: true %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
  if block_settings.text_color != blank
    render 'contrast-override', background_color: '', text_color: block_settings.text_color, section_id: block.id
  endif
%}

<div
  class="cart-title spacing-style text-{{ block_settings.alignment }}{% if block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- comment -%}
    Макет корзины (ноябрь 2026): «Cart (3 items)» текстом вместо кружка-
    счётчика и «Continue shopping» справа. Число обновляется вместе со всей
    секцией: после удаления или смены размера тема перерисовывает её целиком
    (component-cart-items.js → morphSection), так что живой cart-bubble
    здесь не нужен.
  {%- endcomment -%}
  {%- if cart.empty? or force_empty -%}
    <span class="cart-title__icon" aria-hidden="true">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
    </span>
    <h1 class="{{ block_settings.type_preset | default: 'h2' }}">
      {{ 'content.your_cart_is_empty' | t }}
    </h1>
  {%- else -%}
    <div class="cart-title__row">
      <h1 class="{{ block_settings.type_preset | default: 'h2' }}">
        {{ block_settings.title }}
        {%- if block_settings.show_count -%}
          <span class="cart-title__count">
            ({{ cart.item_count }}
            {% if cart.item_count == 1 %}item{% else %}items{% endif %})
          </span>
        {%- endif -%}
      </h1>
      <a class="cart-title__continue" href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}">
        {{- 'actions.continue_shopping' | t -}}
      </a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-title h1 {
    margin-block-end: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
  }

  /* Макет корзины: заголовок антиквой, счётчик серым, ссылка справа. */
  .cart-title__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  /* .cart-title.cart-title — чтобы перебить пресет темы .h3.h3 (0,2,0):
     он ставит заголовку капс. */
  .cart-title.cart-title h1 {
    align-items: baseline;
    font-family: var(--ie-display);
    font-weight: 400;
    font-size: clamp(2.125rem, 3.4vw, 2.75rem);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .cart-title__count {
    font-size: 0.5em;
    color: #767676;
    letter-spacing: 0.02em;
  }

  .cart-title__continue {
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--ie-ink, #111);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cart-title__continue:hover {
    color: var(--brand-accent, var(--ie-bordo, #4e070d));
  }

  .cart-title__icon {
    display: block;
    margin-block-end: 1rem;
    color: #633f47;
  }

  .cart-title .cart-bubble {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-title .cart-bubble[data-maintain-ratio] {
    width: min(1lh, 26px);
    height: min(1lh, 26px);
  }

  .cart-title .cart-bubble .cart-bubble__background {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-title .cart-bubble__text {
    color: var(--color-foreground);
    font-family: var(--font-paragraph--family);
    font-weight: var(--font-paragraph--weight);
    font-size: clamp(var(--font-size--3xs), 0.75em, var(--font-size--xs));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.title",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:settings.cart_title",
      "default": "t:text_defaults.cart"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:settings.cart_count",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.title"
    }
  ]
}
{% endschema %}
