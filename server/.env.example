# Токен бота — получить у @BotFather в Телеграме (/newbot)
BOT_TOKEN=

# Ключ поиска Google через serper.dev (2500 бесплатных запросов).
# Без него будет использоваться DuckDuckGo — работает, но менее надёжно.
SERPER_API_KEY=

# Валюта по умолчанию, если менеджер не указал символ (€/$/£)
DEFAULT_CURRENCY=EUR

# Порт HTTP API (на хостинге обычно задаётся автоматически)
PORT=3000

# PostgreSQL (нужна для интеграции BrandsGateway; бот работает и без неё)
# Формат: postgres://пользователь:пароль@localhost:5432/italianedit
DATABASE_URL=

# Как импортируются товары BrandsGateway:
#   app — базовый тариф BG (GROW): импорт/остатки/заказы делает приложение BG,
#         наш сервер только дотегирует товары для фильтров витрины (по умолчанию).
#   api — тариф REST API/CSV: всё делает наш сервер через API BG (нужны BG_* ниже).
IMPORT_MODE=app

# BrandsGateway REST API (Shopwoo) — только для IMPORT_MODE=api (тариф REST API/CSV).
BG_BASE_URL=https://nova.shopwoo.com
BG_EMAIL=
BG_PASSWORD=
BG_STORE_ID=

# Правило «отдавать 1»: максимум остатка на позицию, публикуемый в Shopify
INVENTORY_CAP=1

# Сколько товаров BG заливать в Shopify за проход (раз в минуту)
SHOPIFY_PUSH_BATCH=25

# Shopify Admin API (кастомное приложение магазина).
# Без них бот работает, но черновики товаров не создаёт.
SHOPIFY_SHOP=italianedit.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Секрет подписи вебхуков Shopify (Settings → Notifications → Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# chat_id телеграм-группы для алертов об ошибках (узнать: /chatid у бота)
ALERT_CHAT_ID=
