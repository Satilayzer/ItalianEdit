{
  "name": "brand-store-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot + product lookup server for the brand clothing store",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lookup": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "grammy": "^1.44.0",
    "pg": "^8.22.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
